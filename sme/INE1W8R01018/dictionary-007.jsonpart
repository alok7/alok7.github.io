425127788873921523031718988336,0.097515835759516926644401867475254,236.030823672960882317529965753425\\r\\nterminal_k_.19_g_.04,p_3ff48d85d15da489daddbab4,True,,0,245.7636964677243375927425210040703,0.104081628461901798295401062351102,243.936721074352525684931506849316\\r\\ntwo_way_growth_0_margin_.10,p_f325c003c80e3858b11b9dfc,True,,0,44.80625901061854284120383552276962,-0.2144652997600613993250467679952142,40.94078515463645943097997892518438\\r\\ntwo_way_growth_0_margin_.14,p_ee5f1ebb8f6288e1f755e881,True,,0,82.01162045678003363876310460016042,-0.1135122963137192025869275685979028,65.80207529162276080084299262381454\\r\\ntwo_way_growth_0_margin_.18,p_4308ae18cf59a34417c36e45,True,,0,119.2169819029415244363223736775503,-0.0446439418173845877933569394991534,90.66336542860906217070600632244462\\r\\ntwo_way_growth_0_margin_.22,p_5f310cc5b9eb8ad8ca40f72d,True,,0,156.4223433491030152338816427549408,0.008689255731744729401468118750116,115.5246555655953635405690200210748\\r\\ntwo_way_growth_.1_margin_.10,p_9153c74f09fddc48ff0f011d,False,2031-10-19,9.999992625,,,65.93554389939356427818756585879923\\r\\ntwo_way_growth_.1_margin_.14,p_b7df7e96146f6bd97d8c8a82,True,,2.578376325,95.56804745503215728427155897027671,-0.0859705688898791518792810693557225,105.9749002779113724973656480505792\\r\\ntwo_way_growth_.1_margin_.18,p_3da62bce0799fcfe87db7861,True,,0,151.3349574960636018047385000756468,0.002040994115868696776537984680823,146.01425665642918071654373024236\\r\\ntwo_way_growth_.1_margin_.22,p_992725bd501a2bb8938326a6,True,,0,207.3852944557259750712524196590396,0.067218214492988365976275436784881,186.0536130349469889357218124341408\\r\\ntwo_way_growth_.2_margin_.10,p_63d7e209fb0a89c4ccd6750f,False,2029-06-26,9.999992625,,,101.8737745159849947312961011591146\\r\\ntwo_way_growth_.2_margin_.14,p_c3dbdaa251002c88a9e34a11,False,2031-07-04,9.999992625,,,163.73661998965074815595363540569\\r\\ntwo_way_growth_.2_margin_.18,p_40aaace5a82dfaf342323fa1,False,,9.999992625,,,225.5994654633165015806111696522654\\r\\ntwo_way_growth_.2_margin_.22,p_f6c5120e2dde32e890d1f2d5,True,,0,276.7862395256385686161729183972325,0.130645702587054144099337648365759,287.4623109369822550052687038988408\\r\\ntwo_way_growth_.3_margin_.10,p_c831117121e90f797ba83112,False,2028-05-26,9.999992625,,,152.0102694242043493150684931506862\\r\\ntwo_way_growth_.3_margin_.14,p_05c27ea56e9be1a01f7ff477,False,2028-11-30,9.999992625,,,244.31849941252489726027397260274\\r\\ntwo_way_growth_.3_margin_.18,p_fdcf4f030ee3aa0907846548,False,2029-12-30,9.999992625,,,336.6267294008454452054794520547946\\r\\ntwo_way_growth_.3_margin_.22,p_5d27df33bc7bc3d6ab896222,False,2031-10-19,9.999992625,,,428.9349593891659931506849315068508\\r\\ntwo_way_growth_.4_margin_.10,p_25df98b00d6961f9c500d9a3,False,2027-12-22,9.999992625,,,220.1893683500719915700737618545838\\r\\ntwo_way_growth_.4_margin_.14,p_22015489f3332addd3bc517b,False,2028-03-19,9.999992625,,,353.8993534164171970495258166491046\\r\\ntwo_way_growth_.4_margin_.18,p_0970167ef6a27003f986c469,False,2028-08-15,9.999992625,,,487.6093384827624025289778714436246\\r\\ntwo_way_growth_.4_margin_.22,p_7bef897a611b0be26c6b8ad0,False,2029-05-26,9.999992625,,,621.3193235491076080084299262381454\\r\\n\"","\"# Robokidz Eduventures Limited\\n## 1. Executive Verdict\\n\\n**Hold: unresolved financial reliability and funding evidence. Not a demonstrated compounder; not eligible for numerical investment ranking.** Robokidz supplies and installs school robotics/STEM laboratories, trains users and provides related educational services. The strongest positive evidence is substantial delivered laboratory revenue, a growing subscription category and a wider geographic/customer mix. The decisive problem is that reported profit has not become operating cash: restated CFO was negative in each of FY24–26, while the original FY25 cash-flow statement included borrowing in CFO. A last-day related-party acquisition also prevents a clean organic-growth and incremental-return bridge. At the secondary 19 October 2026 price reference of ₹149.80, historical earnings multiples alone do not establish an attractive entry. This is an early-stage, project-led growth and funding-risk thesis, not a proven recurring-software thesis. Reconciled cash statements, current funding/utilization, external-customer growth and sustained collections could change the conclusion. A lower price cannot by itself cure the evidence gap.\\n\\n## 2. Research Header, Gates and Data Confidence\\n\\n- **Exact security:** Robokidz Eduventures Limited; ISIN INE1W8R01018; BSE SME scrip 544940, ROBOKIDZ. Incorporated 23 December 2014; public-company conversion 21 April 2026. CIN U74900PN2014PLC153530. Original private-company annual reports use the predecessor CIN ending PTC153530, not a different issuer.\\n- **Cutoff:** information available by 20 October 2026, Asia/Kolkata; market reference 19 October 2026. Later price moves and October 22 clarification are excluded. The primary interoperability security file corroborates the security, issued capital and lot, not a separate NSE listing.\\n- **Scope and accounting:** FY24–25 restated standalone; FY26 restated consolidated, with subsidiary acquired 30 March 2026. Indian GAAP/Accounting Standards, not Ind AS. Older original FY20–23 records remain a separate vintage. All financial amounts are ₹ crore unless explicitly stated; model shares are whole shares, prices INR/share.\\n- **Valuation horizon:** 19 October 2026 to 19 October 2031; 15% analytical equity hurdle, with 12%/18% sensitivities. These are research conventions, not promised returns or personalized suitability advice.\\n- **Liquidity reference:** ₹5 lakh hypothetical position, not the user's position. Current lot 1,200 shares; exact value ₹179,760 at the secondary reference. Two lots are ₹359,520; three are ₹539,280. No executable quote is claimed.\\n\\n| Gate | Status | Reason |\\n|---|---|---|\\n| G1 | Conditional | Documented compliance and stewardship weaknesses; no severe diversion/minority abuse established. GOV 4, not automatic governance cap. |\\n| G2 | Hold — unresolved | Original FY25 CF financing misclassification and original/restated cash vintage, audit lender mismatch, acquisition/perimeter reconciliation and current entry balance cannot be fully resolved. |\\n| G3 | Conditional | IPO proceeds are real but current usage/rollovers and pre-entry settlements are not verified. Conditional model breaches are not evidenced actual funding failure. |\\n| G4 | Conditional | Lot known; secondary close is not executable, full primary tape/current restrictions unavailable; no suspension inferred. |\\n\\nConfidence is high on exact share/lot identity and the existence of the restated negative cash flows; medium on the project business and disclosed governance events; low on underlying organic growth, incremental capital productivity, current available cash and executable liquidity. Audited does not mean comparable, collectible or free of transcription/classification problems. Missing information is not automatically a severe governance or actual funding failure.\\n\\n## 3. Scorecard and Calculation Audit\\n\\nAll factors use the same canonical register. **NS means not scoreable, not zero, a neutral midpoint or a renormalized number.** Bounds are uncertainty ranges from the framework's 1–10 factor scale, not estimated scores. Exact Decimal arithmetic is retained; display rounding is half-up and does not determine classification.\\n\\n| Composite | Final | Coverage | Known subtotal | Raw bound | Cap | Final bound |\\n|---|---|---|---|---|---|---|\\n| BQS | NS | 68.00% | 2.7000 | 3.0200 to 5.9000 | None | 3.0200 to 5.9000 |\\n| GQS | NS | 45.00% | 1.9500 | 2.5000 to 7.4500 | 5 | 2.5000 to 5.0000 |\\n| IAS | NS | 20.00% | 0.6000 | 1.4000 to 8.6000 | None | 1.4000 to 8.6000 |\\n\\nBQS weights: GOV 20%, MOAT 20%, REV 12%, DUR 10%, CAP 12%, CASH 10%, BAL 8%, EXEC 8%. GQS: REV 40%, DUR 20%, EARN 15%, CAP 15%, CASH 10%. IAS: final BQS 25%, R 35%, D 20%, P 10%, L 10%. IAS does not re-add growth/cash/ROIC after BQS. The complete-score coverage of IAS is 20% because Q is itself NS. Supplementary propagation of the BQS bound tightens IAS to 1.9050–7.5750, without making IAS numeric. CASH 2 triggers only the persistent-cash GQS ceiling of 5. GOV 4 does not trigger a governance ceiling; conditional funding does not trigger the evidenced-failure IAS ceiling.\\n\\n| Factor | Score | Confidence | Evidence | Supporting evidence | Counter-evidence / limit |\\n|---|---|---|---|---|---|\\n| GOV | 4 | Medium | E01, E02, E03 | Original FY21 qualification; recurring restatements, bank-return differences, statutory/MSME interest and director appointment during disclosed disqualification weaken stewardship. FY25 RPT sales exceeded half of revenue and acquisition consideration is owed to KMP. | No proven diversion; latest examination says no qualifications requiring adjustment, acquired net assets exceed consideration, fresh IPO has no OFS, and disclosures expose rather than conceal these facts. |\\n| MOAT | 4 | Medium | E04, E05 | Laboratory implementation and school relationships provide useful delivery know-how. Most revenue remains contestable project supply; majority of customers have no binding long-term agreements. | In-house kit design, curriculum and platforms differentiate service, but pricing premium, renewal cohorts, independently monetized IP and durable switching costs are not established. |\\n| REV | NS | Low | E04, E06 | Five-year window chosen first; FY21 is pandemic-distorted with accounting qualification. Three-year fallback crosses a last-day related-party acquisition and changing sales/elimination perimeter. Nominal growth is calculated, but verified organic growth is NS. | Labs, subscriptions and non-Maharashtra revenue expanded strongly; NS is not an allegation that growth was fictitious. |\\n| DUR | 5 | Medium | E04, E05, E07 | Existing institutional delivery and subscription growth establish some access to STEM demand; two franchise and two direct centres are operating. | Tender budgets, concentrated counterparties and long collections limit accessible growth; no binding funded backlog or renewals supports a large TAM claim. |\\n| CAP | NS | Low | E06, E08 | Full capital and acquisition obligations are included in numerical proxies, but late consolidation mismatches closing capital with almost no acquired-period income. Reliable cohort returns and organic incremental denominator are unavailable. | Reported operating margins and returns improve. That does not prove an attractive return on new school labs, software or franchises. |\\n| CASH | 2 | High | E08, E09 | Restated FY24–26 CFO is negative each year and FY24–25 matched standalone cumulative conversion is negative. Large receivables and costly funding demonstrate repeated poor realization, not capex inside CFO. | FY25 collected earlier receivables and FY26 tax cash is a refund; higher sales can explain some investment, but do not reverse the multiyear cash deficit. |\\n| BAL | NS | Low | E08, E10 | March cash equivalents are only 0.2187 crore; restricted deposits cannot be netted. IPO/pre-IPO finance helps, but current cash/debt, acquisition payment, arrears and callable line rollovers remain unverified. | No disclosed default/wilful-defaulter conclusion; completed fresh IPO is real funding, so modeled conditional deficits do not establish actual insolvency. |\\n| EXEC | 5 | Medium | E04, E07 | Project revenue and live centre launches demonstrate operating delivery, and the issuer completed its IPO. Named milestones are audited or dated, not invented earnings guidance. | Recurring late-deployment charges, cash realization and no post-IPO utilization report verified by cutoff prevent a stronger execution score. |\\n| EARN | 5 | Medium | E06, E09 | Operating earnings increased and other income is a small share of FY26 PBT. Current-share EPS is reconstructed instead of mixing weighted shares around bonus/loan conversion. | Restatements, supplier/statutory costs, acquired scope and significant new shares weaken confidence in repeatable per-share earnings. |\\n| R | NS | Low | E10, E11 | No unconditional cash-feasible base IRR is established at the secondary price; early financing and terminal continuation are conditional. | Conditional collection/improved-margin paths and explicit hurdles are modeled without replacing R with a hand-picked successful result. |\\n| D | 3 | Medium | E08, E10, E11 | Receivable collectability, customer loss, callable credit and costly rescue can jointly impair capital. Bear paths exhaust bounded finance and have no ordinary equity return. | IPO cash, customer diversification and realizable receivables can cushion loss; this is a risk assessment, not a liquidation recovery appraisal. |\\n| P | NS | Low | E11, E12 | The approximately 16× historical earnings reference is observable only conditionally, while organic earning base and investable entry cash are unresolved. Reverse paths quantify assumptions rather than declaring the stock cheap. | The price does not necessarily require a SaaS premium; successful high-margin/collection cases exist but are not independently supported. |\\n| L | NS | Low | E12 | Official ISIN/share/lot verified, but no complete primary traded-value history, spread/depth or current restriction file. Listing age is under 20 sessions; no 60-session statistic can be fabricated. | Secondary tape shows trades and lot size is 1200, so it is not declared suspended or untradeable. |\\n\\nEach factor's evidence IDs resolve to two supporting facts and counter-evidence in `evidence_ledger.json`, with source identifiers in the final section. The known BQS contribution is 2.70 and GQS 1.95; BQS missing weight 32%, GQS 55%, IAS 80%. Increasing a scored factor by one changes BQS by its stated weight, or GQS by its stated weight, but cannot resolve missing factors. For example GOV 4→5 adds 0.20 to both BQS bound endpoints; CASH 2→3 adds 0.10 but still leaves the persistent-cash cap. An unsupported positive return does not replace R. The exact R spread schedule and its boundaries are executable in `build.py` and recorded in `score_audit.json`.\\n\\n## 4. Business Overview\\n\\nThe company designs lab solutions, procures components, assembles/customizes kits, arranges outsourced production where relevant, installs facilities, trains educators and supports learning. Schools, institutions and project counterparties are not all equivalent to direct recurring software subscribers. Purchase orders and project completion/acceptance can create revenue before cash collection. Contractor, distributor, related-party or institutional exposures must not be counted as separate schools without a customer bridge. [RHP, business and risks, printed pp 25–26 and 120–135](https://www.robokidz.co.in/media/documents/03-rhp.pdf).\\n\\n| Revenue category | FY24 | FY25 | FY26 | Interpretation |\\n|---|---:|---:|---:|---|\\n| Laboratory setup projects | 32.2526 | 53.2461 | 72.0167 | 77.25% of FY26 revenue; installation/procurement economics dominate |\\n| Subscriptions | 0 | 2.0917 | 11.9284 | 12.80% of FY26; no verified ARR, cohort renewal or net-retention bridge |\\n| Other education services | 5.9133 | 3.4150 | 9.2780 | 9.95%; not automatically high-margin intellectual-property licensing |\\n\\nTwo franchise activity centres and two directly operated company/subsidiary centres were disclosed at RHP date. A franchise is a separate operator relationship, not necessarily consolidated school revenue, guaranteed royalty annuity or an operating centre owned by Robokidz. Course delivery and teacher training are services; in-house Drag-on.ai/LMS and curriculum may improve delivery but do not establish separately monetized IP economics. FY26 LMS subscription expense itself was ₹4.208 crore; education-support and installation direct expenses were approximately ₹1.3855 crore and ₹3.1125 crore. The software label does not remove vendor, service or working-capital costs.\\n\\nHistorical reach statements such as schools served, pupils reached, workshops held, or a future centre network are not current contracts, paid subscribers or executable backlog. Most customer relationships were not governed by binding long-term agreements. Management attributes growth partly to repeat business, but no renewal rate, customer-revenue cohort or independently audited retention measure is disclosed. We therefore do not turn repeat-customer language into an annuity forecast.\\n\\n## 5. Moat / Industry Position\\n\\nThe plausible advantages are delivery experience, curriculum/kit integration, educator relationships and the ability to install and support a complete lab. Evidence of a durable economic moat would require repeat paid cohorts, retained margins after support costs, superior collections, pricing power or substantial switching costs. Those outcomes are not yet demonstrated. Component sourcing and project bidding are contestable; budgets, acceptance delays and counterparties can dominate branded educational content.\\n\\nConcentration improved but remains material: top-one/top-ten customer shares were 57.47%/96.60% in FY24, 55.30%/92.95% in FY25 and 21.11%/77.99% in FY26. Maharashtra revenue share declined from 89.86% to 87.28% to 53.04%. Diversification is a real positive, but changes in the consolidation/RPT perimeter prevent assuming the whole improvement is independent external-customer diversification. [RHP concentration and RPT notes](https://www.robokidz.co.in/media/documents/03-rhp.pdf).\\n\\n**Named economic comparators, not interchangeable valuation peers:**\\n\\n| Company | Primary FY26 evidence | Relevant comparison | Why its multiple is not transferred |\\n|---|---|---|---|\\n| NIIT Learning Systems / NIIT MTS | Revenue ₹1,952 crore, EBITDA ₹395.7 crore (20.3%), PAT ₹247.7 crore; 21 new annuity clients and USD 459 million revenue visibility | Shows what evidence of contracted, recurring learning services can look like | Global corporate managed learning has different clients, contract duration, scale and collections |\\n| NIIT Limited | Revenue ₹390.2 crore, EBITDA loss ₹4 crore, PAT ₹5.3 crore | Skills demand and reported profit do not guarantee strong core operating economics | Learner/training mix and acquisitions differ from lab implementation |\\n| CL Educate | Revenue from operations about ₹548.1 crore; EBITDA ₹69.4 crore and net loss about ₹26 crore; 150-plus test-prep centres | Franchise/service scale and the need to separate acquisition-led revenue from shareholder earnings | First full year of DEXIT changes perimeter; assessment/MarTech financing and amortization differ |\\n\\nThese facts come from the issuers' [NIIT MTS FY26 release](https://www.niit.com/en/learning-outsourcing/news-details/niit-mts-q4-fy26-financial-results/), [NIIT FY26 release](https://www.niit.ai/india/press-release/niit-limited-q4-fy2025-26-consolidated-results) and [CL Educate FY26 annual report, printed pp 29–33](https://www.cleducate.com/pdf/annual-reports/2026/CL-Educate-Annual-Report-2025-26.pdf). The CL bridge attributes approximately +₹195 crore to assessments, −₹21 crore to legacy learning and +₹16 crore to MarTech. This is specifically a warning against reading acquisition growth as organic franchise success. STEMROBO's [official description](https://www.stemrobo.com/about-us/) identifies a direct kits/curriculum/lab competitor, but its undated current page is used only for business-mechanism comparison, never a cutoff-dated scale or financial assertion. No current peer-price table is invented and no peer P/E is used to set Robokidz's terminal value.\\n\\n## 6. Revenue Growth & Scale\\n\\n| FY | Revenue ₹cr | PAT ₹cr | Scope / vintage |\\n|---|---|---|---|\\n| 2020 | 7.1799 | 0.8849 | original standalone |\\n| 2021 | 4.6841 | 0.2025 | original standalone |\\n| 2022 | 16.2738 | 0.2039 | original standalone |\\n| 2023 | 16.4321 | 0.2834 | original standalone |\\n| 2024 | 38.1659 | 2.4235 | standalone |\\n| 2025 | 58.7528 | 4.9782 | standalone |\\n| 2026 | 93.2231 | 10.0569 | consolidated: acquired subsidiary from March 30 only in P&L, full closing balance sheet |\\n\\n| FY | Revenue addition ₹cr | YoY growth | Comparable organic? |\\n|---|---|---|---|\\n| 2021 | -2.4958 | -34.76% | Not established |\\n| 2022 | 11.5898 | 247.43% | Not established |\\n| 2023 | 0.1582 | 0.97% | Not established |\\n| 2024 | 21.7338 | 132.26% | Not established |\\n| 2025 | 20.5869 | 53.94% | Not established |\\n| 2026 | 34.4703 | 58.67% | Not established |\\n\\n| Window | Start ₹cr | End ₹cr | Nominal CAGR | Scorable organic? |\\n|---|---|---|---|---|\\n| 3 years | 16.4321 | 93.2231 | 78.35% | No |\\n| 5 years | 4.6841 | 93.2231 | 81.88% | No |\\n| 10 years | NS | 93.2231 | NS | No |\\n\\nThe 5-year window is selected first, before seeing the score. Its FY21 starting point is pandemic-distorted and has a depreciation qualification. The 3-year fallback starts in FY23 original standalone accounts and ends in a different restated/consolidated perimeter. Ten-year history is ND. These nominal calculations demonstrate growth in recorded scale but do not establish an organic CAGR suitable for REV. No 9/10 growth score is inferred from a short, distorted series.\\n\\nFY24 and FY25 sales to related parties were ₹21.9281 crore and ₹33.7505 crore, roughly 57% of reported revenue. These disappear as an external RPT sales line when the relevant subsidiary is consolidated. That is an elimination/perimeter change, not proof that every FY26 sale is new external demand. RRPL's full-year revenue of ₹41.6372 crore and PAT ₹4.3092 crore are not added to group FY26 earnings: the acquisition was on 30 March, with only the post-acquisition period included. Parent PAT ₹10.1158 crore plus subsidiary post-acquisition loss ₹0.0589 crore gives group PAT ₹10.0569 crore. The parent/consolidated service-revenue difference of approximately ₹0.0824 crore is a limited bridge, not a complete organic sales reconciliation. [RHP RFS38–45](https://www.robokidz.co.in/media/documents/03-rhp.pdf).\\n\\nLab growth, subscription growth and geographical expansion support real delivery, but price, volume, project mix, related-party channel and acquired/eliminated sales are not fully split. There is no invented quarterly CFO or overlapping TTM period. FY20's negative original receivable balance and FY22's changed finance-cost comparative are preserved as vintage warnings rather than silently corrected.\\n\\n## 7. Growth Quality & Reinvestment Runway\\n\\nThe bottom-up route is additional funded institutional orders, installation capacity, educator/service support, collectible subscriptions and economically viable centres. The national education market is not Robokidz's accessible revenue. A funded backlog, conversion funnel, per-lab contribution after service/support, new-centre investment and cash payback would establish a credible duration; these are ND.\\n\\nThe IPO working-capital estimate is especially important. Management projected FY27 standalone working capital of ₹62.9152 crore funded by ₹23.4573 crore IPO proceeds, ₹12.53 crore debt and ₹26.9279 crore internal accrual/equity. This is an unappraised management estimate, not audited cash delivered by October 20. Projected receivable holding days of 136 versus 129 use standalone/average assumptions and must not be compared directly with FY26 consolidated closing DSO near 279 days. [RHP objects, printed pp 82–92](https://www.robokidz.co.in/media/documents/03-rhp.pdf).\\n\\nThe model below charges receivables, inventories, supplier advances, payable terms, capex, cash tax and cash interest to each growth path. It does not assume growth self-finances because EBITDA rises. Optional bank funding is capped gross, rescue equity is whole-share and capped by both authorized shares and ₹10 crore gross, and no rescue is treated as committed financing. A faster-growing company can fail earlier when collections lag. GQS is NS because REV/CAP remain unresolved, and its upper bound is capped at 5 by persistent CASH 2; a large education TAM does not remove that ceiling.\\n\\n## 8. Management, Governance & Execution\\n\\n**Governance conclusion: material concerns, proportionate treatment.** Sagar Sanghvi was disqualified from 1 November 2016 to 31 October 2021 following filing defaults at Gemini Training & Staffing, which was struck off. His disclosed Robokidz appointment from 19 October 2020 to 19 March 2021 overlapped that period. The period has lapsed and no related ROC proceeding is disclosed in the RHP. This is an adverse compliance fact, not proof of fraud, current disqualification or diversion. [RHP/addendum governance risks](https://www.robokidz.co.in/media/documents/03-rhp.pdf).\\n\\nThe March 2026 RRPL acquisition was from related KMP. Consideration ₹5.1714 crore was fully payable at March 31 and is separately included as a cash claim; it is not buried in debt or ignored as non-cash goodwill. Net assets at acquisition ₹9.5217 crore less consideration explain capital reserve ₹4.3503 crore; closing subsidiary net assets ₹9.4628 crore reflect the post-acquisition loss. Book bargain accounting does not prove fair value or acquired earnings quality. The fresh-only IPO has no OFS, a positive alignment fact, but capital raising alone does not prove minority-friendly capital allocation.\\n\\n| Original date / evidence | Commitment or observable milestone | Outcome by cutoff | Assessment |\\n|---|---|---|---|\\n| FY24–FY26, RHP business table | Deliver lab projects, not earnings guidance | Lab revenue ₹32.2526→₹53.2461→₹72.0167 crore | Revenue delivery demonstrated; collection not proved |\\n| September 11 RHP | Activity-centre/franchise expansion | Two franchise plus two direct centres operating | Early execution; larger network ambition not treated as achieved |\\n| July 1 board / RHP objects | FY27 WC ₹23.4573 crore and debt repayment ₹2.2 crore | IPO/listing completed September 28; use by cutoff ND | Funding raised; actual application not yet verified |\\n| FY24–FY26, RFS27 | Meet contracted deployment timelines | Late-deployment penalties ₹0.0190/₹0.0238/₹0.0036 crore | Improving, not zero; no broad guidance beat claimed |\\n| September 11 RHP MD&A | Retention and new customers support growth | No cohort/renewal/ARR bridge | Management attribution, not measured retention |\\n\\nNo arbitrary unissued guidance is manufactured for a promises-versus-delivery score. EXEC 5 recognizes delivery and the IPO while retaining funding, penalty and collection limits.\\n\\n## 9. Financial Forensics\\n\\n### Original audits and full annexures\\n\\n- **FY21:** BMAKS, original AR PDF pp 8–11, expressly qualified depreciation provided under the Income Tax Act; profitability effect unascertained. Retirement benefit obligations were not actuarially provided. No invented numerical adjustment repairs this. CARO was deemed inapplicable; the main report contains a brief positive IFC observation.\\n- **FY22:** MGM, original pp 8–14, unmodified/no KAM; IFC exemption. Inventory-existence wording is not an independent verification conclusion.\\n- **FY23:** MGM, original pp 8–15, unmodified/no KAM; IFC exemption. FY22 original finance cost ₹0.3742756 crore differs from FY23's FY22 comparative ₹0.4094125 crore although PBT/PAT agree. Both vintages are retained.\\n- **FY24:** MGM, original pp 8–16, unmodified/no KAM, IFC exemption and positive audit-trail wording. CARO refers to subsidiary-share purchases before the disclosed March 2026 acquisition. Its GST ₹0.4543211 crore timing wording under a more-than-six-month clause is internally inconsistent. These are textual issues requiring explanation, not allegations of wrongdoing.\\n- **FY25:** G N Mantri, full original pp 11–25, unmodified with a KAM about confirmations of payables/receivables/withheld balances and inability to fully verify GST input-credit reversal on unpaid creditors older than 180 days. Positive IFC/audit-trail and no auditor resignation are counter-evidence. CARO names Ahmednagar Merchants Co-op ₹13.25 crore limits/₹10.567 crore closing, whereas the report's financial notes name HDFC and other lenders. Reconciliation remains open.\\n- **FY26:** the complete RHP examination and RFS1–54 were read. The examination relies on FY24 MGM, FY25 G N Mantri and FY26 Goyal audits and says no qualifications require adjustment. The separate full FY26 statutory audit/CARO was not located; this is not represented as a full independent FY26 CARO clearance.\\n\\nThe issuer's separate link titled FY25 audit report actually contains Bharat Gyan Vigyan Foundation's report. That file was excluded after identity checking. The actual FY25 Robokidz annual report was read and its issuer/CIN verified. The link error is not evidence that the Robokidz annual report belongs to the Foundation. Primary annual-report URLs and reviewed page ranges appear in the source register.\\n\\n### Profit-to-cash and vintage reconciliation\\n\\n| Measure | FY24 | FY25 | FY26 |\\n|---|---|---|---|\\n| operating ebitda | 4.8932 | 9.1410 | 16.5326 |\\n| operating ebit | 4.6922 | 8.7951 | 16.1106 |\\n| normalized pat | 2.3152 | 4.6746 | 9.6879 |\\n| cfo | -3.6447 | -2.0981 | -5.0961 |\\n| cash capex | 1.2068 | 0.1857 | 0.6216 |\\n| fcf | -4.8515 | -2.2838 | -5.7177 |\\n| receivables | 21.4192 | 14.2962 | 71.2776 |\\n| inventory | 2.0846 | 12.0628 | 12.2616 |\\n| payables | 8.5569 | 3.0327 | 21.9401 |\\n| debt | 14.2918 | 15.3431 | 29.8033 |\\n| cash equivalents | 1.6346 | 0.2059 | 0.2187 |\\n| equity | 4.3810 | 10.6092 | 25.0164 |\\n| acquisition payable | 0.0000 | 0.0000 | 5.1714 |\\n| operating ic | 16.1759 | 23.1094 | 65.4891 |\\n| financing ic | 16.5953 | 25.3251 | 59.3716 |\\n| capital definition residual | -0.4194 | -2.2157 | 6.1175 |\\n| closing roic proxy (ratio) | 0.2171 | 0.2848 | 0.1841 |\\n| closing roce proxy (ratio) | 0.2827 | 0.3473 | 0.2714 |\\n| end dso | 204.8428 | 88.8147 | 279.0759 |\\n\\nROIC/ROCE rows above are decimal ratios, not percentages. Operating EBITDA is PBT + all finance cost + D&A − other income. Operating EBIT subtracts operating D&A, excluding investment-property depreciation. Normalized PAT removes all other income after a constant 25.17% analytical tax rate, not a claimed company-specific marginal tax ruling. Recurring finance/statutory/MSME costs are not favorably added back to PAT. Other income remains excluded from operating cash-flow valuation.\\n\\nFY26 issuer KPI EBITDA ₹16.6580 crore uses interest-only ₹2.5805 crore; adding all finance cost ₹2.9482 crore gives ₹17.0257 crore before removing other income ₹0.4931 crore, producing operating EBITDA ₹16.5326 crore. A ratio calculated with a different EBITDA definition is not called the same metric. Restated PAT changed from original ₹2.3335 to ₹2.4235 crore in FY24, ₹5.2816 to ₹4.9782 in FY25 and ₹9.6967 to ₹10.0569 in FY26 through disclosed depreciation, statutory/MSME interest, gratuity, stock/purchase and tax adjustments. These are not ignored because the final examination is unmodified. [RHP RFS14–15, RFS27](https://www.robokidz.co.in/media/documents/03-rhp.pdf).\\n\\n| Scope | CFO sum | PAT sum | CFO/PAT | FCF sum |\\n|---|---|---|---|---|\\n| FY24_25_matched_standalone | -5.7428 | 7.4017 | -77.59% | -7.1353 |\\n| FY26_consolidated | -5.0961 | 10.0569 | -50.67% | -5.7177 |\\n| FY24_26_mixed_scope_diagnostic_only | -10.8389 | 17.4586 | -62.08% | -12.8530 |\\n\\nThe original FY25 CFO ₹5.9767 crore included ₹5.6544 crore of short-term borrowing. Removing that known financing amount leaves ₹0.3223 crore, still ₹2.4204 crore above restated CFO −₹2.0981 crore; the remaining full bridge is unresolved. Original FY24 CFO ₹3.0051 crore also included ₹0.0132 crore borrowing. Original FY25 share-capital increase ₹1.25 crore was presented as financing cash although the RHP identifies loan conversion. Original FY24 closing cash ₹0.2338 crore versus restated ₹1.6346 crore involves CC/OD reclassification and other differences. Never mix these series to claim cash improvement. No reliable original FY21–23 CFO statement was found, so five-year CFO conversion is ND.\\n\\nFY26 restated operating cash flow reconciles: PBT 13.6350 + adjustments 2.7319 = 16.3669 before working capital; advances −1.0009, inventory +0.5959, receivables −36.8281, other assets −0.8298, payables +18.4675 and other liabilities −3.8060 give −7.0345 before cash tax. **Tax is a positive refund of 1.9384**, giving CFO −5.0961, not a cash-tax payment. Capex −0.6216, acquired cash +0.0660, rent +0.0178 and interest income +0.3442 sum to CFI −0.1936, but the printed subtotal is −0.1249: an unresolved **₹0.0687 crore investing-row discrepancy**. No omitted item is invented to close it. Borrowing +17.1844, repayment −10.0153 and cash interest −1.9353 give financing +5.2338. The reported subtotals reconcile to cash increasing 0.0128 from 0.2059 to 0.2187; using the individual investing rows would instead give −0.0559. This additional arithmetic inconsistency reinforces G2 Hold. The sign and classification of each line matter more than a superficially positive CFO percentage.\\n\\nClosing receivables increased ₹56.9814 crore, while the cash-flow receivable movement was ₹36.8281 crore. Their ₹20.1533 crore residual is acquired/perimeter-related until a full acquisition/elimination schedule establishes otherwise, not automatically organic cash absorption. FY26 inventory opening/closing and cash-flow movements similarly require acquired inventory ₹0.7947 crore. More-than-six-month receivables of ₹0.4599 crore were considered good, but age classifications alone cannot establish cash collectability or eligible bank security.\\n\\n### Capital productivity, financing and obligations\\n\\n| Window | Start IC proxy | End full IC | ΔIC | ΔNOPAT | Apparent return | Scoreable |\\n|---|---|---|---|---|---|---|\\n| 3 | 6.1748 | 65.4891 | 59.3143 | 11.2778 | 19.01% | No |\\n| 5 | 4.1871 | 65.4891 | 61.3020 | 11.6946 | 19.08% | No |\\n\\nThese apparent 3/5-year returns are not usable CAP scores: the original start denominator is a minimum trade/fixed-capital proxy, while the final denominator is fuller and includes acquired capital with almost no acquired-period earnings. The numerator uses analytical NOPAT on operating EBIT, not PAT. A one-year/average-capital proxy is also retained in the calculation output; neither solves the scope mismatch. A lagged-capital/cohort test is NS because commissioned investment timing and comparable organic capital are unavailable. The apparent three-/five-year incremental returns are about 19.01%/19.08%. Against an explicitly analytical 13%–19% cost-of-capital range (16% central, matching the terminal discount sensitivities), their apparent spread runs from roughly six percentage points to almost zero. This is not a measured issuer WACC, and actual risk-adjusted capital cost could be higher. Because the numerator and acquired/original capital bases are not comparable, even the apparent positive spread cannot establish economic value creation; CAP remains NS. Reinvestment productivity is not inferred from a small historical PPE base.\\n\\nOperating IC includes receivables, inventory, supplier/staff advances, deposits/retention and fixed/intangible/development assets, less trade payables, customer advances and operating accruals. Financing IC includes equity, all borrowing and unpaid acquisition consideration, less unrestricted equivalents and nonoperating property; pledged deposits are not treated as excess distributable cash. Tax/statutory liabilities, acquired/other assets and classification differences explain why the two proxies do not mechanically coincide; the residual is visible, not force-fitted.\\n\\nMarch 2026 debt was ₹29.8033 crore, mostly current ₹29.4382 crore, including current maturities ₹3.4809 crore. Cash credits were ₹23.2689 crore (HDFC ₹17.2869 crore, PNB ₹5.9820 crore); disclosed directors' interest-free borrowing was ₹0.4125 crore. Some NBFC facilities carried high rates; PNB eligible book debts are subject to age limits, relevant when collections lengthen. Sanctions, utilization, annual renewals and demand provisions need current evidence. Different RHP sections contain lender/rate details that do not fully reconcile, so available headroom is not assumed from a headline limit.\\n\\nCash equivalents were ₹0.2187 crore, all cash in hand, with no bank balance in that category. Short/long deposits totaling ₹5.7954 crore are restricted or not proven freely distributable and are not netted against debt. Statutory dues ₹4.0923 crore, tax provision ₹7.0416 crore and acquisition consideration ₹5.1714 crore are separate claims. MSME principal ₹1.1586 crore plus interest ₹0.1420 crore conflicts with boilerplate saying no MSME dues; no selective benign reading is used. Bank stock-return discrepancies, including FY25 Q4 ₹3.1025 crore, require explanation even if described as provisional. [RHP RFS18–23, 38–39 and 43–44](https://www.robokidz.co.in/media/documents/03-rhp.pdf).\\n\\nAS19 rent is expensed, about ₹0.3701 crore in FY26; disclosed minimum future payments were ₹0.2297 crore within one year and ₹0.0581 crore later. No fictional Ind AS lease debt is added. The model includes rent in operating margins and does not add it a second time. Current tax settlements are assumptions and do not pretend every provision is immediately legally due.\\n\\n**Share/cash bridge:** March 2025 loan conversion ₹1.25 crore was not cash; March 2026 3:1 bonus brought shares to 7,000,000 without cash. April 9 three shares at ₹80 raised ₹240; April 15 343,750 shares at ₹80 raised ₹2.75 crore. April 9 OCD proceeds were ₹4.4999955 crore on 555,555 instruments at ₹81. September 5 conversion issued 582,900 shares with **no second cash inflow**. Pre-IPO shares were 7,926,653; 2,932,800 fresh IPO shares at ₹106 added ₹31.08768 crore gross, giving 10,859,453. A conflicting abbreviated OCD count in prose is not used to overwrite the detailed capital table. Authorized capital permits 12,000,000 shares before a new approval; future authorization expansion is not assumed.\\n\\n## 10. Valuation & Market Expectations\\n\\n| Metric | Value | Limitation |\\n|---|---|---|\\n| Price | 149.80 | Secondary 19 October reference |\\n| Shares | 10859453 | Primary security master |\\n| Market cap ₹cr | 162.6746 | Conditional on secondary quote |\\n| P/E reported | 16.18 | FY26 current-share denominator |\\n| P/E normalized | 16.79 | Remove all other income after analytical tax |\\n| March EV ₹cr | 197.4306 | Stale debt/cash plus acquisition payable; not current EV |\\n| March EV/operating EBITDA | 11.94 | Same stale-balance warning |\\n| Lot value ₹ | 179760.00 | 1,200 shares, not an execution guarantee |\\n\\nThe quote is a dated secondary reference, not current verified exchange execution. Finology's displayed legacy P/E/debt figures were not adopted. Current FY26 earnings use current shares, not weighted pre-issue EPS. March book value and EV are explicitly stale balance-sheet diagnostics: April/September proceeds, spending, debt repayment and claims may materially change current EV. Do not simply subtract gross IPO proceeds from debt without accounting for fees and use. Price alone can be observed more readily than the cash available to its owners.\\n\\n### Cash-linked model and financing discipline\\n\\nAll forecasts are analyst assumptions. The audited starting date is March 31, not a fabricated cash-rich entry date. Seven pre-entry periods bridge to October 19 with scheduled April equity/OCD proceeds, September OCD conversion and IPO, assumed IPO costs ₹3 crore (₹2/₹5 sensitivities), ₹2.2 crore debt repayment and payment of the acquisition claim. Opening tax/statutory provisions are settled over seven modeled installments; the sensitivity set does not silently postpone or forgive a residual. Pre-entry revenue run-rate ₹105 crore, 15% EBITDA margin, DSO 260, inventory 55 days and payables 80 days are conditional, not reported interim results.\\n\\nThe default pre-entry collection timing receives 80% of each cycle's customer collections before operating outlays. A separately labeled improved-collection bridge uses DSO 220 and 100% early receipt. The latter is not selected because it is true: it isolates what must improve before the forward model is even cash-feasible. Reverse post-entry growth cannot repair a pre-entry shortfall. No actual default is inferred from an underidentified historical cash reconstruction.\\n\\nPost-entry bear/base/bull assumptions are revenue CAGR 3%/15%/25%; EBITDA margin 10%/15%/18%; DSO 360/240/180; inventory days 85/55/45; supplier days 50/70/70; within-cycle early receipt 50%/80%/90%. Bear writes off 10% of opening receivables non-cash and calls 20% of cash-credit principal; base/bull assume renewal, not guaranteed renewal. All use supplier advances 3.06% and customer advances 0.365% of revenue, maintenance capex 0.7%, incremental fixed-capital investment 1% of added annual revenue and operating D&A 0.45% of revenue. These modest fixed-asset assumptions fit an implementation/outsourcing model but do not eliminate working capital.\\n\\nCash tax is 25.17% of positive operating EBIT with no interest tax shield, a conservative simplification. Existing debt costs 13%, optional bank debt 17%, pre-entry OCD 10%. Interest is charged on cycle-end balances; 4/8/16-cycle tests expose discretization around dated issues/conversion rather than pretending exact daily accrual. The model assumes additional principal amortization of ₹3.4809 crore in forward year one and ₹0.3651 crore in year two after the IPO debt payment. This is a deliberately conservative cash schedule, not an asserted contractual allocation of the IPO repayment to specific maturities; all principal is bounded by debt outstanding.\\n\\nEach monthly period contains eight chronological collection/cost/tax/capex/interest cycles. The cash floor is ₹0.20 crore. Gross optional bank draw is capped at ₹3 crore, including pre-entry usage; no uncommitted line is counted as certain. Post-entry equity rescue uses the minimum whole shares required at 75% of the reference market price, 3% fees, a ₹10 crore gross cap and authorized-share headroom. The same bounded equity policy can fund the terminal continuation reserve, not merely the ordinary cash floor; no terminal bank refinancing or cure of an earlier breach is allowed. Borrowing/equity costs, principal, dilution and share rounding all affect returns. Once any cash event breaches the floor, no later fundraising cures the historical failure; the path continues only as an explicitly unfunded counterfactual and ordinary equity return is null.\\n\\n| Bridge / scenario / finance | Survives | First failure | Bank ₹cr | Equity ₹cr | Terminal ₹ | 5y IRR |\\n|---|---|---|---|---|---|---|\\n| unverified bridge / bear / no optional finance | False | 2026-04-03 operating_cash_cost | 0.00 | 0.00 | NS | NS |\\n| unverified bridge / bear / bounded optional | False | 2026-08-31 opening_statutory_settlement_assumed | 3.00 | 0.00 | NS | NS |\\n| unverified bridge / base / no optional finance | False | 2026-04-03 operating_cash_cost | 0.00 | 0.00 | NS | NS |\\n| unverified bridge / base / bounded optional | False | 2026-08-31 opening_statutory_settlement_assumed | 3.00 | 0.00 | NS | NS |\\n| unverified bridge / bull / no optional finance | False | 2026-04-03 operating_cash_cost | 0.00 | 0.00 | NS | NS |\\n| unverified bridge / bull / bounded optional | False | 2026-08-31 opening_statutory_settlement_assumed | 3.00 | 0.00 | NS | NS |\\n| improved collection bridge / bear / no optional finance | False | 2027-01-11 operating_cash_cost | 0.00 | 0.00 | NS | NS |\\n| improved collection bridge / bear / bounded optional | False | 2027-03-30 operating_cash_cost | 3.00 | 10.00 | NS | NS |\\n| improved collection bridge / base / no optional finance | False | 2031-10-19 terminal_all_debt_settlement | 0.00 | 0.00 | NS | NS |\\n| improved collection bridge / base / bounded optional | False | 2031-10-19 terminal_all_debt_settlement | 0.00 | 10.00 | NS | NS |\\n| improved collection bridge / bull / no optional finance | True | None | 0.00 | 0.00 | 288.70 | 14.02% |\\n| improved collection bridge / bull / bounded optional | True | None | 0.00 | 0.00 | 288.70 | 14.02% |\\n\\nTerminal value is earned, not assigned to every trajectory. All remaining debt is paid before the ordinary equity claim. A dated next-year continuation test determines permanent operating cash: at least the floor and 2% of next revenue, and enough to cover the largest within-year cash deficit. Next capex and ΔWC enter FCFF once; there is no second blanket reinvestment prefunding deduction. The reserve scales with perpetual revenue, so its annual growth is separately deducted from distributable FCFF. Baseline perpetual growth 3% and discount rate 16% require positive continuing FCFF, funded reserve, all debt settled and no earlier breach. Enterprise value is next distributable FCFF divided by (16%−3%), plus only cash above the required reserve for equity. No interim dividend or cash-distribution double count occurs. The implied terminal P/E is an output, not a borrowed software multiple.\\n\\n### Reverse expectations, hurdle prices and sensitivity\\n\\n| Variable | Target | Threshold | Meaning |\\n|---|---|---|---|\\n| margin | Current price, 0% return | 16.81% | valuation crossing |\\n| margin | 12% hurdle | 23.44% | valuation crossing |\\n| margin | 15% hurdle | 25.63% | valuation crossing |\\n| margin | 18% hurdle | 28.06% | valuation crossing |\\n| margin | 5× | NS | No jointly cash-feasible/value-meeting path in bounded scan; no extrapolated root |\\n| margin | 10× | NS | No jointly cash-feasible/value-meeting path in bounded scan; no extrapolated root |\\n| growth | Current price, 0% return | NS | No jointly cash-feasible/value-meeting path in bounded scan; no extrapolated root |\\n| growth | 12% hurdle | NS | No jointly cash-feasible/value-meeting path in bounded scan; no extrapolated root |\\n| growth | 15% hurdle | NS | No jointly cash-feasible/value-meeting path in bounded scan; no extrapolated root |\\n| growth | 18% hurdle | NS | No jointly cash-feasible/value-meeting path in bounded scan; no extrapolated root |\\n| growth | 5× | NS | No jointly cash-feasible/value-meeting path in bounded scan; no extrapolated root |\\n| growth | 10× | NS | No jointly cash-feasible/value-meeting path in bounded scan; no extrapolated root |\\n\\nThese bounded scans solve jointly for financing survival and terminal value, rather than filling a missing failed-path IRR with a number. Margin scans cover 8%–36% at 15% revenue growth; growth scans cover 0%–60% at 15% margin, all conditional on the improved pre-entry bridge. A funding discontinuity is explicitly distinguished from a smooth valuation crossing. Every coarse scan, failed lower endpoint and 20-step refinement is retained; no missing root is extrapolated outside its stated range.\\n\\n| Conditional path | 12% hurdle | 15% hurdle | 18% hurdle |\\n|---|---|---|---|\\n| improved collection bridge / base / bounded optional | NS | NS | NS |\\n| improved collection bridge / bull / bounded optional | 163.82 | 143.54 | 126.19 |\\n\\nThese are conditional path-equivalent prices, not actionable buy zones: a surviving bull path does not turn an unsupported base case into R. The improved-bridge bull returns about 14.02% at the reference price, below the 15% hurdle despite 25% revenue growth, 18% margins and 180-day DSO. At fixed 15% growth, the modeled 15% shareholder hurdle requires approximately 25.63% margin, conditional on the bridge and funding discipline, well above observed normalized operating margin.\\n\\n| Sensitivity | Survives | First breach | Rescue ₹cr | Terminal ₹ | IRR |\\n|---|---|---|---|---|---|\\n| bank gross cap 0 | False | 2031-10-19 | 10.00 | NS | NS |\\n| post DSO 180 | True | None | 0.00 | 159.54 | 1.27% |\\n| post DSO 300 | False | 2028-12-22 | 10.00 | NS | NS |\\n| margin .18 | True | None | 0.00 | 171.32 | 2.72% |\\n| margin .22 | True | None | 0.00 | 239.49 | 9.84% |\\n| line rollover .8 | False | Continuation reserve | 10.00 | NS | NS |\\n| cycle count 4 | True | None | 0.00 | 288.71 | 14.02% |\\n| cycle count 16 | True | None | 0.00 | 288.70 | 14.02% |\\n| terminal k .13 g .03 | True | None | 0.00 | 368.95 | 19.75% |\\n| terminal k .19 g .03 | True | None | 0.00 | 238.54 | 9.75% |\\n\\nFull one-variable sensitivities cover DSO, within-period collection timing, capex, IPO fees, gross bank availability, rescue discounts, cash floor, rollover and cycle granularity. A 5×4 growth/margin matrix and 3×3 perpetual discount/growth matrix are included. Downside cases are not assigned peer-multiple rescue values. Current-price expectations remain NS until operating/funding evidence supports a base path.\\n\\nThe archive retains **191 retained trial aliases, 187 unique complete paths, 67 failed unique paths**, losslessly keyed by path ID. Every path includes all cash events, pre-entry and monthly balances, annual financials, rescue terms and next-year continuation events. Repeated trials share an identical path object but each requested trial has an alias. Failed paths are not dropped to make the output look cleaner.\\n\\n## 11. Bear Case & Permanent-Loss Path\\n\\nThe strongest adverse case is not merely a lower terminal multiple. A concentrated institution/channel delays or disputes acceptance; receivables age beyond finance eligibility; suppliers shorten terms; cash-credit renewal tightens; interest, taxes and acquired-owner claims consume fresh funds; a deeply discounted issue exhausts authorized/gross capacity before collections arrive. A 10% opening receivable write-off is ₹7.1278 crore, material relative to reported equity, without any claim that this loss has occurred. Loss of the largest FY26 customer could affect approximately 21% of sales before replacement and cost adjustment.\\n\\nThe cash-linked bear case jointly tests slower growth, a 10% margin, 360-day collection, 85-day inventory, 50-day supplier terms, 80% line renewal and the receivable haircut. Failed financing paths have no ordinary terminal share price, not a fabricated precision liquidation value. Actual equity recovery would require receivable aging/realizations, secured-creditor priorities, taxes and asset liquidation evidence that is unavailable. Material impairment and recapitalization risk justify D 3, while absence of actual default evidence keeps G3 conditional.\\n\\nThe best counterargument is that IPO liquidity, prior-receivable collection and broader customers allow profitable lab delivery to convert into cash, while subscriptions improve margins. The model gives that argument a cash-feasible chance, but only under explicit collection/margin assumptions. **Thesis-break variable: funded cash conversion**, not announced school reach. Repeated negative CFO after the financing cycle, uncollectible/disputed major receivables or an uncovered callable-debt event would override a growing order pipeline.\\n\\n## 12. 5× / 10× Feasibility\\n\\nFive-year 5× and 10× prices require annualized shareholder returns of approximately 37.97% and 58.49%, respectively, before taxes and trading costs. They are not equivalent to company revenue CAGR. The retained reverse tests calculate target prices ₹749 and ₹1,498 from ₹149.80 and require survival of every preceding cash event, all dilution/interest/principal, a funded growing cash reserve and cash-flow-supported terminal value. Profit growth, per-share dilution and the implied terminal multiple are separately visible in `reverse_tests.json`.\\n\\nA margin root above the observed sustainable operating evidence is an assumption threshold, not proof of a multibagger. Where no jointly feasible root exists within the bounded growth or margin range, the answer is “not demonstrated,” not an extrapolated optimistic price. Acquisition revenue, repeat-customer claims, more franchise logos or a SaaS multiple cannot substitute for cash earned per share. Neither a 5× nor 10× outcome is a supported base expectation here.\\n\\n## 13. Monitoring Plan\\n\\n1. **Cash-flow correction:** obtain a signed original-to-restated FY24/FY25 CFO/cash bridge, specifically borrowing in CFO, CC/OD and loan-conversion cash. Unexplained financing classification keeps G2 on Hold.\\n2. **Current liquidity:** post-IPO bank statements/cash balance, loan confirmations and uses of ₹31.08768 crore gross proceeds, with fees, ₹2.2 crore debt allocation, acquisition consideration and tax/statutory payments. No double-counting of April OCD cash.\\n3. **Receivable realization:** collect the March ₹71.2776 crore book, acquired versus organic amounts, aging, disputes and amounts eligible under lender terms. Failure to approach a funded 220–240-day path is adverse, not merely slower accounting growth.\\n4. **External revenue bridge:** parent/subsidiary elimination schedule, new/repeat customer cohorts, project acceptance and lab/subscription split. Resolve the FY24/25 majority-RPT channel before scoring organic REV.\\n5. **Bank renewals:** limits, drawing power, collateral, covenant status, rates and callable balances. Stress any loss of the modeled ₹3 crore optional capacity; do not wait for a formal default to update D.\\n6. **Subscription economics:** contracted seats, paid renewal/cohort revenue, support/LMS cost and cash collection. Use true renewal evidence, not number of schools ever reached.\\n7. **Capital productivity:** incremental lab/centre/software investment, acquired capital and organic NOPAT, including failed or delayed centres. CAP stays NS until a comparable return denominator is available.\\n8. **Governance execution:** resolve CARO lender, subsidiary-timing, statutory/MSME and confirmation inconsistencies; track filing timeliness and any material RPT/related-party payment change.\\n9. **Tradability:** obtain official daily traded-value history, zero-trade days, spread/depth, free float and current restrictions. Recompute ₹5 lakh capacity at 2%, 5%, 10%; an indicative close is never an exit guarantee.\\n10. **Falsification:** sustained positive cash after taxes/support costs and normal reinvestment, with no hidden borrowing in CFO, supports re-underwriting. Continued multiyear negative conversion or equity needed merely to pay earlier claims defeats the compounder claim.\\n\\n## 14. Final Classification & Conditional Action\\n\\n**Hold — unresolved financial reliability and funding evidence.** BQS, GQS and IAS remain NS, with explicit bounds and confidence. Do not place this company in a numeric Best Businesses, Best Growth or Best Investments ranking until the missing evidence is resolved. This is not “Avoid — governance” because severe diversion/minority abuse is not established, nor “Avoid — funding” merely because an assumed cash schedule breaches. G2's unresolved reliability gate precedes the classification matrix.\\n\\nNo compounder designation is supportable: BQS≥8/GQS≥7 and sustained reinvestment/cash conditions are not established. No portfolio allocation or executable entry instruction follows. A lower observed price can improve conditional modeled returns, but cannot fix an unverified cash bridge or provide liquidity. The appropriate next action is primary reconciliation and post-IPO evidence, then rebuild the same canonical factors and cash model without changing the scoring goalposts.\\n\\nResearch update: initial v3.0 review as of the stated cutoff. Earlier FY20–23 audited vintages, original versus restated FY24–26 differences and secondary-price limitations have been added explicitly; no later market event is used to improve hindsight. Scores are research-policy heuristics, not statistically validated predictors.\\n\\n## 15. Sources, Assumptions & Open Questions\\n\\n| ID | Record / date | Reviewed use |\\n|---|---|---|\\n| AR22 | [Annual Report – FY 2021-22 (PDF)](https://www.robokidz.co.in/media/documents/04-annual-report-fy-2021-22.pdf) · FY ended 2022-03-31 | Entire original audit/opinion, CARO/IFC where applicable, financial statements and relevant notes. Original report issuer identity and units checked. Original versus restated vintages preserved. |\\n| AR23 | [Annual Report – FY 2022-23 (PDF)](https://www.robokidz.co.in/media/documents/03-annual-report-fy-2022-23.pdf) · FY ended 2023-03-31 | Entire original audit/opinion, CARO/IFC where applicable, financial statements and relevant notes. Original report issuer identity and units checked. Original versus restated vintages preserved. |\\n| AR24 | [Annual Report – FY 2023-24 (PDF)](https://www.robokidz.co.in/media/documents/02-annual-report-fy-2023-24.pdf) · FY ended 2024-03-31 | Entire original audit/opinion, CARO/IFC where applicable, financial statements and relevant notes. Original report issuer identity and units checked. Original versus restated vintages preserved. |\\n| ADD | [Addendum to DRHP (PDF)](https://www.robokidz.co.in/media/documents/04-addendum-to-drhp.pdf) · 2026 pre-RHP | Disqualification, revised risk/RPT and business disclosures. |\\n| RHP | [RHP (PDF)](https://www.robokidz.co.in/media/documents/03-rhp.pdf) · 2026-09-11 | RHP front matter, risks, capital structure, objects, business, history, governance, entire restated examination report and RFS1–54, MDA, litigation, approvals. |\\n| AR21 | [Annual Report – FY 2020-21 (PDF)](https://www.robokidz.co.in/media/documents/05-annual-report-fy-2020-21.pdf) · FY ended 2021-03-31 | Entire original audit/opinion, CARO/IFC where applicable, financial statements and relevant notes. Original report issuer identity and units checked. Original versus restated vintages preserved. |\\n| WRONG-AUDIT | [Audit Report – FY 2024-25 (PDF)](https://www.robokidz.co.in/media/documents/06-audit-report-fy-2024-25.pdf) · FY2025 | Identity check only: linked file belongs to Bharat Gyan Vigyan Foundation, not issuer. Excluded from issuer opinion conclusions. |\\n| AR25 | [Annual Report – FY 2024-25 (PDF)](https://www.robokidz.co.in/media/documents/01-annual-report-fy-2024-25.pdf) · FY ended 2025-03-31 | Entire original audit/opinion, CARO/IFC where applicable, financial statements and relevant notes. Original report issuer identity and units checked. Original versus restated vintages preserved. |\\n| SEC | [NSE interoperability security master](https://nsearchives.nseindia.com/content/cm/interop/NSE_CM_security_19102026.csv.gz) · 2026-10-19 | Exact ISIN, issued shares and lot; not represented as a separate NSE listing or executable quote. |\\n| MKT | [Finology observed quote](https://ticker.finology.in/Company/SCRIP-325713) · 2026-10-19 | Observed secondary price ₹149.80; displayed legacy P/E and debt are not adopted. |\\n| LIST | [BSE listing notice 20260925-42, mirrored by NoticeBlue](https://noticeblue.com/circulars/a3fbe800-ded3-4528-bf13-09db1a43f494) · 2026-09-25 | 10,859,453 shares, 1,200-share lot, ₹106 issue price and September 28 listing. Official endpoint unavailable; mirror labeled. |\\n| PEER-MTS | [NIIT Learning Systems FY26 results](https://www.niit.com/en/learning-outsourcing/news-details/niit-mts-q4-fy26-financial-results/) · 2026-05-12 | Issuer FY26 results: ₹1,952 crore revenue, ₹395.7 crore EBITDA, ₹247.7 crore PAT; 21 new annuity clients and USD459 million visibility. Corporate services comparator, not a lab-project multiple. |\\n| PEER-NIIT | [NIIT Limited FY26 results](https://www.niit.ai/india/press-release/niit-limited-q4-fy2025-26-consolidated-results) · 2026-05-14 | Issuer FY26 results: ₹390.2 crore revenue, EBITDA loss ₹4 crore and PAT ₹5.3 crore. Skills demand does not guarantee operating profitability. |\\n| PEER-CLE | [CL Educate FY26 annual report](https://www.cleducate.com/pdf/annual-reports/2026/CL-Educate-Annual-Report-2025-26.pdf) · FY2026 issued2026 | FY26 business model, franchise network and acquisition bridge: ₹548.1 crore revenue and about ₹26 crore net loss. First full year of DEXIT changes perimeter. |\\n| PEER-STEM | [STEMROBO official business description](https://www.stemrobo.com/about-us/) · Undated, retrieved2026-10-23 | Direct curriculum/kits/AI robotics lab competitor; undated web description used only to identify mechanism, not assert historical scale or financial performance. |\\n\\nThe full source register carries primary-file hashes, review scope and cutoff eligibility. Evidence type is explicit: verified document fact, issuer/management assertion, secondary quote/mirror, or analyst assumption. Undated competitor web content is not cutoff-dated financial evidence. Official BSE daily-data attempts returned access failures; failures do not prove zero trading. The official security master establishes only fields actually read. No raw PDF, OCR, private download URL, helper code or private Library ID is included in the deliverables.\\n\\nAll model inputs are bundled with standard-library code in both compact and full recovery archives. Compact contains authored minimal inputs and code, so it can regenerate every complete path and failed root without access to original PDFs, web, private directories or precomputed outputs. Full adds generated tables and lossless path history. Clean rebuilding removes generated outputs and old attestations before running under declared read/write restrictions and a network/process prohibition. Rebuild checks validate arithmetic and internal consistency; they do not turn unresolved economic evidence into verified facts.\\n\\nKey open questions are signed historical cash reconciliation; current available cash/debt and IPO utilization; original FY26 full audit annexures; organic/acquired/customer-elimination bridges; capital cohort paybacks; recurring subscription retention; and primary executable market evidence. No approval to trade, new financing commitment or forecast certainty is inferred.\\n\\n### Required v3 final checks\\n\\n| # | Required check | Status | Disposition |\\n|---|---|---|---|\\n| 1 | Identity and scope | PASS with qualification | ISIN/share count verified; standalone versus last-day consolidated scope explicit; price secondary. |\\n| 2 | Primary records | PASS | Original FY21–25 audits and full RHP examination/notes reviewed; claims source-linked. |\\n| 3 | Audit/RPT/funding/dilution | PASS with unresolved gate | Adverse findings proportionate; G2 Hold, G1/G3 conditional, no invented default. |\\n| 4 | Comparable periods and units | PASS with limitation | Original rupees/INR00 converted to crore, vintages distinct; no invented TTM or quarterly CFO. |\\n| 5 | Growth decomposition | UNRESOLVED and NS | Organic/acquired/elimination bridge unavailable; nominal CAGR diagnostics not REV score. |\\n| 6 | Cash conversion | PASS | Matched ratio of sums; capex outside CFO; original borrowing misclassification isolated. |\\n| 7 | Incremental capital | UNRESOLVED and NS | 3/5-year numerator/denominator proxies visible; lagged/cohort return unsupported, CAP NS. |\\n| 8 | Normalization and claims | PASS with limitation | Other income, operating D&A, taxes, lease expense, acquisition liability and all issue shares reconciled. |\\n| 9 | Cash-linked scenarios | PASS | Dated pre-entry/intraperiod cash, integer rescue caps, first failures retained, terminal debt and continuation cash tested. |\\n| 10 | Canonical factors and weights | PASS | Single factor register; all three weights sum exactly one. |\\n| 11 | Missing evidence | PASS | NS stays null; coverage, bounds and confidence supplied. |\\n| 12 | Raw/final overrides | PASS | Only persistent CASH cap on GQS; no governance/funding cap invented. |\\n| 13 | Classification | PASS | Gate Hold precedes matrix; no compounder or investable ranking. |\\n| 14 | Liquidity | UNRESOLVED and NS | ₹5 lakh reference, 1200 lot, 2/5/10% formula; incomplete primary tape, no executable-price claim. |\\n| 15 | Bear and falsification | PASS | Concentration/collections/rollover/recapitalization path and measurable breakers explicit. |\\n| 16 | Ranking consistency | PASS | v3.0 common basis; incomplete company excluded from numeric ranking, not imputed or ranked. |\\n\\nConcluding assessment: recorded revenue has expanded substantially, but the evidence does not yet establish that expansion can repeatedly protect economics, earn attractive incremental returns, become cash and increase intrinsic value per share without fragile funding. The conditional price model quantifies what must change; it does not waive the evidence gap.\\n\"","\"number\"","\"content_markdown\"","\"Executive Verdict\"","\"\\n**Hold: unresolved financial reliability and funding evidence. Not a demonstrated compounder; not eligible for numerical investment ranking.** Robokidz supplies and installs school robotics/STEM laboratories, trains users and provides related educational services. The strongest positive evidence is substantial delivered laboratory revenue, a growing subscription category and a wider geographic/customer mix. The decisive problem is that reported profit has not become operating cash: restated CFO was negative in each of FY24–26, while the original FY25 cash-flow statement included borrowing in CFO. A last-day related-party acquisition also prevents a clean organic-growth and incremental-return bridge. At the secondary 19 October 2026 price reference of ₹149.80, historical earnings multiples alone do not establish an attractive entry. This is an early-stage, project-led growth and funding-risk thesis, not a proven recurring-software thesis. Reconciled cash statements, current funding/utilization, external-customer growth and sustained collections could change the conclusion. A lower price cannot by itself cure the evidence gap.\\n\\n\"","\"Research Header, Gates and Data Confidence\"","\"\\n- **Exact security:** Robokidz Eduventures Limited; ISIN INE1W8R01018; BSE SME scrip 544940, ROBOKIDZ. Incorporated 23 December 2014; public-company conversion 21 April 2026. CIN U74900PN2014PLC153530. Original private-company annual reports use the predecessor CIN ending PTC153530, not a different issuer.\\n- **Cutoff:** information available by 20 October 2026, Asia/Kolkata; market reference 19 October 2026. Later price moves and October 22 clarification are excluded. The primary interoperability security file corroborates the security, issued capital and lot, not a separate NSE listing.\\n- **Scope and accounting:** FY24–25 restated standalone; FY26 restated consolidated, with subsidiary acquired 30 March 2026. Indian GAAP/Accounting Standards, not Ind AS. Older original FY20–23 records remain a separate vintage. All financial amounts are ₹ crore unless explicitly stated; model shares are whole shares, prices INR/share.\\n- **Valuation horizon:** 19 October 2026 to 19 October 2031; 15% analytical equity hurdle, with 12%/18% sensitivities. These are research conventions, not promised returns or personalized suitability advice.\\n- **Liquidity reference:** ₹5 lakh hypothetical position, not the user's position. Current lot 1,200 shares; exact value ₹179,760 at the secondary reference. Two lots are ₹359,520; three are ₹539,280. No executable quote is claimed.\\n\\n| Gate | Status | Reason |\\n|---|---|---|\\n| G1 | Conditional | Documented compliance and stewardship weaknesses; no severe diversion/minority abuse established. GOV 4, not automatic governance cap. |\\n| G2 | Hold — unresolved | Original FY25 CF financing misclassification and original/restated cash vintage, audit lender mismatch, acquisition/perimeter reconciliation and current entry balance cannot be fully resolved. |\\n| G3 | Conditional | IPO proceeds are real but current usage/rollovers and pre-entry settlements are not verified. Conditional model breaches are not evidenced actual funding failure. |\\n| G4 | Conditional | Lot known; secondary close is not executable, full primary tape/current restrictions unavailable; no suspension inferred. |\\n\\nConfidence is high on exact share/lot identity and the existence of the restated negative cash flows; medium on the project business and disclosed governance events; low on underlying organic growth, incremental capital productivity, current available cash and executable liquidity. Audited does not mean comparable, collectible or free of transcription/classification problems. Missing information is not automatically a severe governance or actual funding failure.\\n\\n\"","\"Scorecard and Calculation Audit\"","\"\\nAll factors use the same canonical register. **NS means not scoreable, not zero, a neutral midpoint or a renormalized number.** Bounds are uncertainty ranges from the framework's 1–10 factor scale, not estimated scores. Exact Decimal arithmetic is retained; display rounding is half-up and does not determine classification.\\n\\n| Composite | Final | Coverage | Known subtotal | Raw bound | Cap | Final bound |\\n|---|---|---|---|---|---|---|\\n| BQS | NS | 68.00% | 2.7000 | 3.0200 to 5.9000 | None | 3.0200 to 5.9000 |\\n| GQS | NS | 45.00% | 1.9500 | 2.5000 to 7.4500 | 5 | 2.5000 to 5.0000 |\\n| IAS | NS | 20.00% | 0.6000 | 1.4000 to 8.6000 | None | 1.4000 to 8.6000 |\\n\\nBQS weights: GOV 20%, MOAT 20%, REV 12%, DUR 10%, CAP 12%, CASH 10%, BAL 8%, EXEC 8%. GQS: REV 40%, DUR 20%, EARN 15%, CAP 15%, CASH 10%. IAS: final BQS 25%, R 35%, D 20%, P 10%, L 10%. IAS does not re-add growth/cash/ROIC after BQS. The complete-score coverage of IAS is 20% because Q is itself NS. Supplementary propagation of the BQS bound tightens IAS to 1.9050–7.5750, without making IAS numeric. CASH 2 triggers only the persistent-cash GQS ceiling of 5. GOV 4 does not trigger a governance ceiling; conditional funding does not trigger the evidenced-failure IAS ceiling.\\n\\n| Factor | Score | Confidence | Evidence | Supporting evidence | Counter-evidence / limit |\\n|---|---|---|---|---|---|\\n| GOV | 4 | Medium | E01, E02, E03 | Original FY21 qualification; recurring restatements, bank-return differences, statutory/MSME interest and director appointment during disclosed disqualification weaken stewardship. FY25 RPT sales exceeded half of revenue and acquisition consideration is owed to KMP. | No proven diversion; latest examination says no qualifications requiring adjustment, acquired net assets exceed consideration, fresh IPO has no OFS, and disclosures expose rather than conceal these facts. |\\n| MOAT | 4 | Medium | E04, E05 | Laboratory implementation and school relationships provide useful delivery know-how. Most revenue remains contestable project supply; majority of customers have no binding long-term agreements. | In-house kit design, curriculum and platforms differentiate service, but pricing premium, renewal cohorts, independently monetized IP and durable switching costs are not established. |\\n| REV | NS | Low | E04, E06 | Five-year window chosen first; FY21 is pandemic-distorted with accounting qualification. Three-year fallback crosses a last-day related-party acquisition and changing sales/elimination perimeter. Nominal growth is calculated, but verified organic growth is NS. | Labs, subscriptions and non-Maharashtra revenue expanded strongly; NS is not an allegation that growth was fictitious. |\\n| DUR | 5 | Medium | E04, E05, E07 | Existing institutional delivery and subscription growth establish some access to STEM demand; two franchise and two direct centres are operating. | Tender budgets, concentrated counterparties and long collections limit accessible growth; no binding funded backlog or renewals supports a large TAM claim. |\\n| CAP | NS | Low | E06, E08 | Full capital and acquisition obligations are included in numerical proxies, but late consolidation mismatches closing capital with almost no acquired-period income. Reliable cohort returns and organic incremental denominator are unavailable. | Reported operating margins and returns improve. That does not prove an attractive return on new school labs, software or franchises. |\\n| CASH | 2 | High | E08, E09 | Restated FY24–26 CFO is negative each year and FY24–25 matched standalone cumulative conversion is negative. Large receivables and costly funding demonstrate repeated poor realization, not capex inside CFO. | FY25 collected earlier receivables and FY26 tax cash is a refund; higher sales can explain some investment, but do not reverse the multiyear cash deficit. |\\n| BAL | NS | Low | E08, E10 | March cash equivalents are only 0.2187 crore; restricted deposits cannot be netted. IPO/pre-IPO finance helps, but current cash/debt, acquisition payment, arrears and callable line rollovers remain unverified. | No disclosed default/wilful-defaulter conclusion; completed fresh IPO is real funding, so modeled conditional deficits do not establish actual insolvency. |\\n| EXEC | 5 | Medium | E04, E07 | Project revenue and live centre launches demonstrate operating delivery, and the issuer completed its IPO. Named milestones are audited or dated, not invented earnings guidance. | Recurring late-deployment charges, cash realization and no post-IPO utilization report verified by cutoff prevent a stronger execution score. |\\n| EARN | 5 | Medium | E06, E09 | Operating earnings increased and other income is a small share of FY26 PBT. Current-share EPS is reconstructed instead of mixing weighted shares around bonus/loan conversion. | Restatements, supplier/statutory costs, acquired scope and significant new shares weaken confidence in repeatable per-share earnings. |\\n| R | NS | Low | E10, E11 | No unconditional cash-feasible base IRR is established at the secondary price; early financing and terminal continuation are conditional. | Conditional collection/improved-margin paths and explicit hurdles are modeled without replacing R with a hand-picked successful result. |\\n| D | 3 | Medium | E08, E10, E11 | Receivable collectability, customer loss, callable credit and costly rescue can jointly impair capital. Bear paths exhaust bounded finance and have no ordinary equity return. | IPO cash, customer diversification and realizable receivables can cushion loss; this is a risk assessment, not a liquidation recovery appraisal. |\\n| P | NS | Low | E11, E12 | The approximately 16× historical earnings reference is observable only conditionally, while organic earning base and investable entry cash are unresolved. Reverse paths quantify assumptions rather than declaring the stock cheap. | The price does not necessarily require a SaaS premium; successful high-margin/collection cases exist but are not independently supported. |\\n| L | NS | Low | E12 | Official ISIN/share/lot verified, but no complete primary traded-value history, spread/depth or current restriction file. Listing age is under 20 sessions; no 60-session statistic can be fabricated. | Secondary tape shows trades and lot size is 1200, so it is not declared suspended or untradeable. |\\n\\nEach factor's evidence IDs resolve to two supporting facts and counter-evidence in `evidence_ledger.json`, with source identifiers in the final section. The known BQS contribution is 2.70 and GQS 1.95; BQS missing weight 32%, GQS 55%, IAS 80%. Increasing a scored factor by one changes BQS by its stated weight, or GQS by its stated weight, but cannot resolve missing factors. For example GOV 4→5 adds 0.20 to both BQS bound endpoints; CASH 2→3 adds 0.10 but still leaves the persistent-cash cap. An unsupported positive return does not replace R. The exact R spread schedule and its boundaries are executable in `build.py` and recorded in `score_audit.json`.\\n\\n\"","\"Business Overview\"","\"\\nThe company designs lab solutions, procures components, assembles/customizes kits, arranges outsourced production where relevant, installs facilities, trains educators and supports learning. Schools, institutions and project counterparties are not all equivalent to direct recurring software subscribers. Purchase orders and project completion/acceptance can create revenue before cash collection. Contractor, distributor, related-party or institutional exposures must not be counted as separate schools without a customer bridge. [RHP, business and risks, printed pp 25–26 and 120–135](https://www.robokidz.co.in/media/documents/03-rhp.pdf).\\n\\n| Revenue category | FY24 | FY25 | FY26 | Interpretation |\\n|---|---:|---:|---:|---|\\n| Laboratory setup projects | 32.2526 | 53.2461 | 72.0167 | 77.25% of FY26 revenue; installation/procurement economics dominate |\\n| Subscriptions | 0 | 2.0917 | 11.9284 | 12.80% of FY26; no verified ARR, cohort renewal or net-retention bridge |\\n| Other education services | 5.9133 | 3.4150 | 9.2780 | 9.95%; not automatically high-margin intellectual-property licensing |\\n\\nTwo franchise activity centres and two directly operated company/subsidiary centres were disclosed at RHP date. A franchise is a separate operator relationship, not necessarily consolidated school revenue, guaranteed royalty annuity or an operating centre owned by Robokidz. Course delivery and teacher training are services; in-house Drag-on.ai/LMS and curriculum may improve delivery but do not establish separately monetized IP economics. FY26 LMS subscription expense itself was ₹4.208 crore; education-support and installation direct expenses were approximately ₹1.3855 crore and ₹3.1125 crore. The software label does not remove vendor, service or working-capital costs.\\n\\nHistorical reach statements such as schools served, pupils reached, workshops held, or a future centre network are not current contracts, paid subscribers or executable backlog. Most customer relationships were not governed by binding long-term agreements. Management attributes growth partly to repeat business, but no renewal rate, customer-revenue cohort or independently audited retention measure is disclosed. We therefore do not turn repeat-customer language into an annuity forecast.\\n\\n\"","\"Moat / Industry Position\"","\"\\nThe plausible advantages are delivery experience, curriculum/kit integration, educator relationships and the ability to install and support a complete lab. Evidence of a durable economic moat would require repeat paid cohorts, retained margins after support costs, superior collections, pricing power or substantial switching costs. Those outcomes are not yet demonstrated. Component sourcing and project bidding are contestable; budgets, acceptance delays and counterparties can dominate branded educational content.\\n\\nConcentration improved but remains material: top-one/top-ten customer shares were 57.47%/96.60% in FY24, 55.30%/92.95% in FY25 and 21.11%/77.99% in FY26. Maharashtra revenue share declined from 89.86% to 87.28% to 53.04%. Diversification is a real positive, but changes in the consolidation/RPT perimeter prevent assuming the whole improvement is independent external-customer diversification. [RHP concentration and RPT notes](https://www.robokidz.co.in/media/documents/03-rhp.pdf).\\n\\n**Named economic comparators, not interchangeable valuation peers:**\\n\\n| Company | Primary FY26 evidence | Relevant comparison | Why its multiple is not transferred |\\n|---|---|---|---|\\n| NIIT Learning Systems / NIIT MTS | Revenue ₹1,952 crore, EBITDA ₹395.7 crore (20.3%), PAT ₹247.7 crore; 21 new annuity clients and USD 459 million revenue visibility | Shows what evidence of contracted, recurring learning services can look like | Global corporate managed learning has different clients, contract duration, scale and collections |\\n| NIIT Limited | Revenue ₹390.2 crore, EBITDA loss ₹4 crore, PAT ₹5.3 crore | Skills demand and reported profit do not guarantee strong core operating economics | Learner/training mix and acquisitions differ from lab implementation |\\n| CL Educate | Revenue from operations about ₹548.1 crore; EBITDA ₹69.4 crore and net loss about ₹26 crore; 150-plus test-prep centres | Franchise/service scale and the need to separate acquisition-led revenue from shareholder earnings | First full year of DEXIT changes perimeter; assessment/MarTech financing and amortization differ |\\n\\nThese facts come from the issuers' [NIIT MTS FY26 release](https://www.niit.com/en/learning-outsourcing/news-details/niit-mts-q4-fy26-financial-results/), [NIIT FY26 release](https://www.niit.ai/india/press-release/niit-limited-q4-fy2025-26-consolidated-results) and [CL Educate FY26 annual report, printed pp 29–33](https://www.cleducate.com/pdf/annual-reports/2026/CL-Educate-Annual-Report-2025-26.pdf). The CL bridge attributes approximately +₹195 crore to assessments, −₹21 crore to legacy learning and +₹16 crore to MarTech. This is specifically a warning against reading acquisition growth as organic franchise success. STEMROBO's [official description](https://www.stemrobo.com/about-us/) identifies a direct kits/curriculum/lab competitor, but its undated current page is used only for business-mechanism comparison, never a cutoff-dated scale or financial assertion. No current peer-price table is invented and no peer P/E is used to set Robokidz's terminal value.\\n\\n\"","\"Revenue Growth & Scale\"","\"\\n| FY | Revenue ₹cr | PAT ₹cr | Scope / vintage |\\n|---|---|---|---|\\n| 2020 | 7.1799 | 0.8849 | original standalone |\\n| 2021 | 4.6841 | 0.2025 | original standalone |\\n| 2022 | 16.2738 | 0.2039 | original standalone |\\n| 2023 | 16.4321 | 0.2834 | original standalone |\\n| 2024 | 38.1659 | 2.4235 | standalone |\\n| 2025 | 58.7528 | 4.9782 | standalone |\\n| 2026 | 93.2231 | 10.0569 | consolidated: acquired subsidiary from March 30 only in P&L, full closing balance sheet |\\n\\n| FY | Revenue addition ₹cr | YoY growth | Comparable organic? |\\n|---|---|---|---|\\n| 2021 | -2.4958 | -34.76% | Not established |\\n| 2022 | 11.5898 | 247.43% | Not established |\\n| 2023 | 0.1582 | 0.97% | Not established |\\n| 2024 | 21.7338 | 132.26% | Not established |\\n| 2025 | 20.5869 | 53.94% | Not established |\\n| 2026 | 34.4703 | 58.67% | Not established |\\n\\n| Window | Start ₹cr | End ₹cr | Nominal CAGR | Scorable organic? |\\n|---|---|---|---|---|\\n| 3 years | 16.4321 | 93.2231 | 78.35% | No |\\n| 5 years | 4.6841 | 93.2231 | 81.88% | No |\\n| 10 years | NS | 93.2231 | NS | No |\\n\\nThe 5-year window is selected first, before seeing the score. Its FY21 starting point is pandemic-distorted and has a depreciation qualification. The 3-year fallback starts in FY23 original standalone accounts and ends in a different restated/consolidated perimeter. Ten-year history is ND. These nominal calculations demonstrate growth in recorded scale but do not establish an organic CAGR suitable for REV. No 9/10 growth score is inferred from a short, distorted series.\\n\\nFY24 and FY25 sales to related parties were ₹21.9281 crore and ₹33.7505 crore, roughly 57% of reported revenue. These disappear as an external RPT sales line when the relevant subsidiary is consolidated. That is an elimination/perimeter change, not proof that every FY26 sale is new external demand. RRPL's full-year revenue of ₹41.6372 crore and PAT ₹4.3092 crore are not added to group FY26 earnings: the acquisition was on 30 March, with only the post-acquisition period included. Parent PAT ₹10.1158 crore plus subsidiary post-acquisition loss ₹0.0589 crore gives group PAT ₹10.0569 crore. The parent/consolidated service-revenue difference of approximately ₹0.0824 crore is a limited bridge, not a complete organic sales reconciliation. [RHP RFS38–45](https://www.robokidz.co.in/media/documents/03-rhp.pdf).\\n\\nLab growth, subscription growth and geographical expansion support real delivery, but price, volume, project mix, related-party channel and acquired/eliminated sales are not fully split. There is no invented quarterly CFO or overlapping TTM period. FY20's negative original receivable balance and FY22's changed finance-cost comparative are preserved as vintage warnings rather than silently corrected.\\n\\n\"","\"Growth Quality & Reinvestment Runway\"","\"\\nThe bottom-up route is additional funded institutional orders, installation capacity, educator/service support, collectible subscriptions and economically viable centres. The national education market is not Robokidz's accessible revenue. A funded backlog, conversion funnel, per-lab contribution after service/support, new-centre investment and cash payback would establish a credible duration; these are ND.\\n\\nThe IPO working-capital estimate is especially important. Management projected FY27 standalone working capital of ₹62.9152 crore funded by ₹23.4573 crore IPO proceeds, ₹12.53 crore debt and ₹26.9279 crore internal accrual/equity. This is an unappraised management estimate, not audited cash delivered by October 20. Projected receivable holding days of 136 versus 129 use standalone/average assumptions and must not be compared directly with FY26 consolidated closing DSO near 279 days. [RHP objects, printed pp 82–92](https://www.robokidz.co.in/media/documents/03-rhp.pdf).\\n\\nThe model below charges receivables, inventories, supplier advances, payable terms, capex, cash tax and cash interest to each growth path. It does not assume growth self-finances because EBITDA rises. Optional bank funding is capped gross, rescue equity is whole-share and capped by both authorized shares and ₹10 crore gross, and no rescue is treated as committed financing. A faster-growing company can fail earlier when collections lag. GQS is NS because REV/CAP remain unresolved, and its upper bound is capped at 5 by persistent CASH 2; a large education TAM does not remove that ceiling.\\n\\n\"","\"Management, Governance & Execution\"","\"\\n**Governance conclusion: material concerns, proportionate treatment.** Sagar Sanghvi was disqualified from 1 November 2016 to 31 October 2021 following filing defaults at Gemini Training & Staffing, which was struck off. His disclosed Robokidz appointment from 19 October 2020 to 19 March 2021 overlapped that period. The period has lapsed and no related ROC proceeding is disclosed in the RHP. This is an adverse compliance fact, not proof of fraud, current disqualification or diversion. [RHP/addendum governance risks](https://www.robokidz.co.in/media/documents/03-rhp.pdf).\\n\\nThe March 2026 RRPL acquisition was from related KMP. Consideration ₹5.1714 crore was fully payable at March 31 and is separately included as a cash claim; it is not buried in debt or ignored as non-cash goodwill. Net assets at acquisition ₹9.5217 crore less consideration explain capital reserve ₹4.3503 crore; closing subsidiary net assets ₹9.4628 crore reflect the post-acquisition loss. Book bargain accounting does not prove fair value or acquired earnings quality. The fresh-only IPO has no OFS, a positive alignment fact, but capital raising alone does not prove minority-friendly capital allocation.\\n\\n| Original date / evidence | Commitment or observable milestone | Outcome by cutoff | Assessment |\\n|---|---|---|---|\\n| FY24–FY26, RHP business table | Deliver lab projects, not earnings guidance | Lab revenue ₹32.2526→₹53.2461→₹72.0167 crore | Revenue delivery demonstrated; collection not proved |\\n| September 11 RHP | Activity-centre/franchise expansion | Two franchise plus two direct centres operating | Early execution; larger network ambition not treated as achieved |\\n| July 1 board / RHP objects | FY27 WC ₹23.4573 crore and debt repayment ₹2.2 crore | IPO/listing completed September 28; use by cutoff ND | Funding raised; actual application not yet verified |\\n| FY24–FY26, RFS27 | Meet contracted deployment timelines | Late-deployment penalties ₹0.0190/₹0.0238/₹0.0036 crore | Improving, not zero; no broad guidance beat claimed |\\n| September 11 RHP MD&A | Retention and new customers support growth | No cohort/renewal/ARR bridge | Management attribution, not measured retention |\\n\\nNo arbitrary unissued guidance is manufactured for a promises-versus-delivery score. EXEC 5 recognizes delivery and the IPO while retaining funding, penalty and collection limits.\\n\\n\"","\"Financial Forensics\"","\"\\n### Original audits and full annexures\\n\\n- **FY21:** BMAKS, original AR PDF pp 8–11, expressly qualified depreciation provided under the Income Tax Act; profitability effect unascertained. Retirement benefit obligations were not actuarially provided. No invented numerical adjustment repairs this. CARO was deemed inapplicable; the main report contains a brief positive IFC observation.\\n- **FY22:** MGM, original pp 8–14, unmodified/no KAM; IFC exemption. Inventory-existence wording is not an independent verification conclusion.\\n- **FY23:** MGM, original pp 8–15, unmodified/no KAM; IFC exemption. FY22 original finance cost ₹0.3742756 crore differs from FY23's FY22 comparative ₹0.4094125 crore although PBT/PAT agree. Both vintages are retained.\\n- **FY24:** MGM, original pp 8–16, unmodified/no KAM, IFC exemption and positive audit-trail wording. CARO refers to subsidiary-share purchases before the disclosed March 2026 acquisition. Its GST ₹0.4543211 crore timing wording under a more-than-six-month clause is internally inconsistent. These are textual issues requiring explanation, not allegations of wrongdoing.\\n- **FY25:** G N Mantri, full original pp 11–25, unmodified with a KAM about confirmations of payables/receivables/withheld balances and inability to fully verify GST input-credit reversal on unpaid creditors older than 180 days. Positive IFC/audit-trail and no auditor resignation are counter-evidence. CARO names Ahmednagar Merchants Co-op ₹13.25 crore limits/₹10.567 crore closing, whereas the report's financial notes name HDFC and other lenders. Reconciliation remains open.\\n- **FY26:** the complete RHP examination and RFS1–54 were read. The examination relies on FY24 MGM, FY25 G N Mantri and FY26 Goyal audits and says no qualifications require adjustment. The separate full FY26 statutory audit/CARO was not located; this is not represented as a full independent FY26 CARO clearance.\\n\\nThe issuer's separate link titled FY25 audit report actually contains Bharat Gyan Vigyan Foundation's report. That file was excluded after identity checking. The actual FY25 Robokidz annual report was read and its issuer/CIN verified. The link error is not evidence that the Robokidz annual report belongs to the Foundation. Primary annual-report URLs and reviewed page ranges appear in the source register.\\n\\n### Profit-to-cash and vintage reconciliation\\n\\n| Measure | FY24 | FY25 | FY26 |\\n|---|---|---|---|\\n| operating ebitda | 4.8932 | 9.1410 | 16.5326 |\\n| operating ebit | 4.6922 | 8.7951 | 16.1106 |\\n| normalized pat | 2.3152 | 4.6746 | 9.6879 |\\n| cfo | -3.6447 | -2.0981 | -5.0961 |\\n| cash capex | 1.2068 | 0.1857 | 0.6216 |\\n| fcf | -4.8515 | -2.2838 | -5.7177 |\\n| receivables | 21.4192 | 14.2962 | 71.2776 |\\n| inventory | 2.0846 | 12.0628 | 12.2616 |\\n| payables | 8.5569 | 3.0327 | 21.9401 |\\n| debt | 14.2918 | 15.3431 | 29.8033 |\\n| cash equivalents | 1.6346 | 0.2059 | 0.2187 |\\n| equity | 4.3810 | 10.6092 | 25.0164 |\\n| acquisition payable | 0.0000 | 0.0000 | 5.1714 |\\n| operating ic | 16.1759 | 23.1094 | 65.4891 |\\n| financing ic | 16.5953 | 25.3251 | 59.3716 |\\n| capital definition residual | -0.4194 | -2.2157 | 6.1175 |\\n| closing roic proxy (ratio) | 0.2171 | 0.2848 | 0.1841 |\\n| closing roce proxy (ratio) | 0.2827 | 0.3473 | 0.2714 |\\n| end dso | 204.8428 | 88.8147 | 279.0759 |\\n\\nROIC/ROCE rows above are decimal ratios, not percentages. Operating EBITDA is PBT + all finance cost + D&A − other income. Operating EBIT subtracts operating D&A, excluding investment-property depreciation. Normalized PAT removes all other income after a constant 25.17% analytical tax rate, not a claimed company-specific marginal tax ruling. Recurring finance/statutory/MSME costs are not favorably added back to PAT. Other income remains excluded from operating cash-flow valuation.\\n\\nFY26 issuer KPI EBITDA ₹16.6580 crore uses interest-only ₹2.5805 crore; adding all finance cost ₹2.9482 crore gives ₹17.0257 crore before removing other income ₹0.4931 crore, producing operating EBITDA ₹16.5326 crore. A ratio calculated with a different EBITDA definition is not called the same metric. Restated PAT changed from original ₹2.3335 to ₹2.4235 crore in FY24, ₹5.2816 to ₹4.9782 in FY25 and ₹9.6967 to ₹10.0569 in FY26 through disclosed depreciation, statutory/MSME interest, gratuity, stock/purchase and tax adjustments. These are not ignored because the final examination is unmodified. [RHP RFS14–15, RFS27](https://www.robokidz.co.in/media/documents/03-rhp.pdf).\\n\\n| Scope | CFO sum | PAT sum | CFO/PAT | FCF sum |\\n|---|---|---|---|---|\\n| FY24_25_matched_standalone | -5.7428 | 7.4017 | -77.59% | -7.1353 |\\n| FY26_consolidated | -5.0961 | 10.0569 | -50.67% | -5.7177 |\\n| FY24_26_mixed_scope_diagnostic_only | -10.8389 | 17.4586 | -62.08% | -12.8530 |\\n\\nThe original FY25 CFO ₹5.9767 crore included ₹5.6544 crore of short-term borrowing. Removing that known financing amount leaves ₹0.3223 crore, still ₹2.4204 crore above restated CFO −₹2.0981 crore; the remaining full bridge is unresolved. Original FY24 CFO ₹3.0051 crore also included ₹0.0132 crore borrowing. Original FY25 share-capital increase ₹1.25 crore was presented as financing cash although the RHP identifies loan conversion. Original FY24 closing cash ₹0.2338 crore versus restated ₹1.6346 crore involves CC/OD reclassification and other differences. Never mix these series to claim cash improvement. No reliable original FY21–23 CFO statement was found, so five-year CFO conversion is ND.\\n\\nFY26 restated operating cash flow reconciles: PBT 13.6350 + adjustments 2.7319 = 16.3669 before working capital; advances −1.0009, inventory +0.5959, receivables −36.8281, other assets −0.8298, payables +18.4675 and other liabilities −3.8060 give −7.0345 before cash tax. **Tax is a positive refund of 1.9384**, giving CFO −5.0961, not a cash-tax payment. Capex −0.6216, acquired cash +0.0660, rent +0.0178 and interest income +0.3442 sum to CFI −0.1936, but the printed subtotal is −0.1249: an unresolved **₹0.0687 crore investing-row discrepancy**. No omitted item is invented to close it. Borrowing +17.1844, repayment −10.0153 and cash interest −1.9353 give financing +5.2338. The reported subtotals reconcile to cash increasing 0.0128 from 0.2059 to 0.2187; using the individual investing rows would instead give −0.0559. This additional arithmetic inconsistency reinforces G2 Hold. The sign and classification of each line matter more than a superficially positive CFO percentage.\\n\\nClosing receivables increased ₹56.9814 crore, while the cash-flow receivable movement was ₹36.8281 crore. Their ₹20.1533 crore residual is acquired/perimeter-related until a full acquisition/elimination schedule establishes otherwise, not automatically organic cash absorption. FY26 inventory opening/closing and cash-flow movements similarly require acquired inventory ₹0.7947 crore. More-than-six-month receivables of ₹0.4599 crore were considered good, but age classifications alone cannot establish cash collectability or eligible bank security.\\n\\n### Capital productivity, financing and obligations\\n\\n| Window | Start IC proxy | End full IC | ΔIC | ΔNOPAT | Apparent return | Scoreable |\\n|---|---|---|---|---|---|---|\\n| 3 | 6.1748 | 65.4891 | 59.3143 | 11.2778 | 19.01% | No |\\n| 5 | 4.1871 | 65.4891 | 61.3020 | 11.6946 | 19.08% | No |\\n\\nThese apparent 3/5-year returns are not usable CAP scores: the original start denominator is a minimum trade/fixed-capital proxy, while the final denominator is fuller and includes acquired capital with almost no acquired-period earnings. The numerator uses analytical NOPAT on operating EBIT, not PAT. A one-year/average-capital proxy is also retained in the calculation output; neither solves the scope mismatch. A lagged-capital/cohort test is NS because commissioned investment timing and comparable organic capital are unavailable. The apparent three-/five-year incremental returns are about 19.01%/19.08%. Against an explicitly analytical 13%–19% cost-of-capital range (16% central, matching the terminal discount sensitivities), their apparent spread runs from roughly six percentage points to almost zero. This is not a measured issuer WACC, and actual risk-adjusted capital cost could be higher. Because the numerator and acquired/original capital bases are not comparable, even the apparent positive spread cannot establish economic value creation; CAP remains NS. Reinvestment productivity is not inferred from a small historical PPE base.\\n\\nOperating IC includes receivables, inventory, supplier/staff advances, deposits/retention and fixed/intangible/development assets, less trade payables, customer advances and operating accruals. Financing IC includes equity, all borrowing and unpaid acquisition consideration, less unrestricted equivalents and nonoperating property; pledged deposits are not treated as excess distributable cash. Tax/statutory liabilities, acquired/other assets and classification differences explain why the two proxies do not mechanically coincide; the residual is visible, not force-fitted.\\n\\nMarch 2026 debt was ₹29.8033 crore, mostly current ₹29.4382 crore, including current maturities ₹3.4809 crore. Cash credits were ₹23.2689 crore (HDFC ₹17.2869 crore, PNB ₹5.9820 crore); disclosed directors' interest-free borrowing was ₹0.4125 crore. Some NBFC facilities carried high rates; PNB eligible book debts are subject to age limits, relevant when collections lengthen. Sanctions, utilization, annual renewals and demand provisions need current evidence. Different RHP sections contain lender/rate details that do not fully reconcile, so available headroom is not assumed from a headline limit.\\n\\nCash equivalents were ₹0.2187 crore, all cash in hand, with no bank balance in that category. Short/long deposits totaling ₹5.7954 crore are restricted or not proven freely distributable and are not netted against debt. Statutory dues ₹4.0923 crore, tax provision ₹7.0416 crore and acquisition consideration ₹5.1714 crore are separate claims. MSME principal ₹1.1586 crore plus interest ₹0.1420 crore conflicts with boilerplate saying no MSME dues; no selective benign reading is used. Bank stock-return discrepancies, including FY25 Q4 ₹3.1025 crore, require explanation even if described as provisional. [RHP RFS18–23, 38–39 and 43–44](https://www.robokidz.co.in/media/documents/03-rhp.pdf).\\n\\nAS19 rent is expensed, about ₹0.3701 crore in FY26; disclosed minimum future payments were ₹0.2297 crore within one year and ₹0.0581 crore later. No fictional Ind AS lease debt is added. The model includes rent in operating margins and does not add it a second time. Current tax settlements are assumptions and do not pretend every provision is immediately legally due.\\n\\n**Share/cash bridge:** March 2025 loan conversion ₹1.25 crore was not cash; March 2026 3:1 bonus brought shares to 7,000,000 without cash. April 9 three shares at ₹80 raised ₹240; April 15 343,750 shares at ₹80 raised ₹2.75 crore. April 9 OCD proceeds were ₹4.4999955 crore on 555,555 instruments at ₹81. September 5 conversion issued 582,900 shares with **no second cash inflow**. Pre-IPO shares were 7,926,653; 2,932,800 fresh IPO shares at ₹106 added ₹31.08768 crore gross, giving 10,859,453. A conflicting abbreviated OCD count in prose is not used to overwrite the detailed capital table. Authorized capital permits 12,000,000 shares before a new approval; future authorization expansion is not assumed.\\n\\n\"","\"Valuation & Market Expectations\"","\"\\n| Metric | Value | Limitation |\\n|---|---|---|\\n| Price | 149.80 | Secondary 19 October reference |\\n| Shares | 10859453 | Primary security master |\\n| Market cap ₹cr | 162.6746 | Conditional on secondary quote |\\n| P/E reported | 16.18 | FY26 current-share denominator |\\n| P/E normalized | 16.79 | Remove all other income after analytical tax |\\n| March EV ₹cr | 197.4306 | Stale debt/cash plus acquisition payable; not current EV |\\n| March EV/operating EBITDA | 11.94 | Same stale-balance warning |\\n| Lot value ₹ | 179760.00 | 1,200 shares, not an execution guarantee |\\n\\nThe quote is a dated secondary reference, not current verified exchange execution. Finology's displayed legacy P/E/debt figures were not adopted. Current FY26 earnings use current shares, not weighted pre-issue EPS. March book value and EV are explicitly stale balance-sheet diagnostics: April/September proceeds, spending, debt repayment and claims may materially change current EV. Do not simply subtract gross IPO proceeds from debt without accounting for fees and use. Price alone can be observed more readily than the cash available to its owners.\\n\\n### Cash-linked model and financing discipline\\n\\nAll forecasts are analyst assumptions. The audited starting date is March 31, not a fabricated cash-rich entry date. Seven pre-entry periods bridge to October 19 with scheduled April equity/OCD proceeds, September OCD conversion and IPO, assumed IPO costs ₹3 crore (₹2/₹5 sensitivities), ₹2.2 crore debt repayment and payment of the acquisition claim. Opening tax/statutory provisions are settled over seven modeled installments; the sensitivity set does not silently postpone or forgive a residual. Pre-entry revenue run-rate ₹105 crore, 15% EBITDA margin, DSO 260, inventory 55 days and payables 80 days are conditional, not reported interim results.\\n\\nThe default pre-entry collection timing receives 80% of each cycle's customer collections before operating outlays. A separately labeled improved-collection bridge uses DSO 220 and 100% early receipt. The latter is not selected because it is true: it isolates what must improve before the forward model is even cash-feasible. Reverse post-entry growth cannot repair a pre-entry shortfall. No actual default is inferred from an underidentified historical cash reconstruction.\\n\\nPost-entry bear/base/bull assumptions are revenue CAGR 3%/15%/25%; EBITDA margin 10%/15%/18%; DSO 360/240/180; inventory days 85/55/45; supplier days 50/70/70; within-cycle early receipt 50%/80%/90%. Bear writes off 10% of opening receivables non-cash and calls 20% of cash-credit principal; base/bull assume renewal, not guaranteed renewal. All use supplier advances 3.06% and customer advances 0.365% of revenue, maintenance capex 0.7%, incremental fixed-capital investment 1% of added annual revenue and operating D&A 0.45% of revenue. These modest fixed-asset assumptions fit an implementation/outsourcing model but do not eliminate working capital.\\n\\nCash tax is 25.17% of positive operating EBIT with no interest tax shield, a conservative simplification. Existing debt costs 13%, optional bank debt 17%, pre-entry OCD 10%. Interest is charged on cycle-end balances; 4/8/16-cycle tests expose discretization around dated issues/conversion rather than pretending exact daily accrual. The model assumes additional principal amortization of ₹3.4809 crore in forward year one and ₹0.3651 crore in year two after the IPO debt payment. This is a deliberately conservative cash schedule, not an asserted contractual allocation of the IPO repayment to specific maturities; all principal is bounded by debt outstanding.\\n\\nEach monthly period contains eight chronological collection/cost/tax/capex/interest cycles. The cash floor is ₹0.20 crore. Gross optional bank draw is capped at ₹3 crore, including pre-entry usage; no uncommitted line is counted as certain. Post-entry equity rescue uses the minimum whole shares required at 75% of the reference market price, 3% fees, a ₹10 crore gross cap and authorized-share headroom. The same bounded equity policy can fund the terminal continuation reserve, not merely the ordinary cash floor; no terminal bank refinancing or cure of an earlier breach is allowed. Borrowing/equity costs, principal, dilution and share rounding all affect returns. Once any cash event breaches the floor, no later fundraising cures the historical failure; the path continues only as an explicitly unfunded counterfactual and ordinary equity return is null.\\n\\n| Bridge / scenario / finance | Survives | First failure | Bank ₹cr | Equity ₹cr | Terminal ₹ | 5y IRR |\\n|---|---|---|---|---|---|---|\\n| unverified bridge / bear / no optional finance | False | 2026-04-03 operating_cash_cost | 0.00 | 0.00 | NS | NS |\\n| unverified bridge / bear / bounded optional | False | 2026-08-31 opening_statutory_settlement_assumed | 3.00 | 0.00 | NS | NS |\\n| unverified bridge / base / no optional finance | False | 2026-04-03 operating_cash_cost | 0.00 | 0.00 | NS | NS |\\n| unverified bridge / base / bounded optional | False | 2026-08-31 opening_statutory_settlement_assumed | 3.00 | 0.00 | NS | NS |\\n| unverified bridge / bull / no optional finance | False | 2026-04-03 operating_cash_cost | 0.00 | 0.00 | NS | NS |\\n| unverified bridge / bull / bounded optional | False | 2026-08-31 opening_statutory_settlement_assumed | 3.00 | 0.00 | NS | NS |\\n| improved collection bridge / bear / no optional finance | False | 2027-01-11 operating_cash_cost | 0.00 | 0.00 | NS | NS |\\n| improved collection bridge / bear / bounded optional | False | 2027-03-30 operating_cash_cost | 3.00 | 10.00 | NS | NS |\\n| improved collection bridge / base / no optional finance | False | 2031-10-19 terminal_all_debt_settlement | 0.00 | 0.00 | NS | NS |\\n| improved collection bridge / base / bounded optional | False | 2031-10-19 terminal_all_debt_settlement | 0.00 | 10.00 | NS | NS |\\n| improved collection bridge / bull / no optional finance | True | None | 0.00 | 0.00 | 288.70 | 14.02% |\\n| improved collection bridge / bull / bounded optional | True | None | 0.00 | 0.00 | 288.70 | 14.02% |\\n\\nTerminal value is earned, not assigned to every trajectory. All remaining debt is paid before the ordinary equity claim. A dated next-year continuation test determines permanent operating cash: at least the floor and 2% of next revenue, and enough to cover the largest within-year cash deficit. Next capex and ΔWC enter FCFF once; there is no second blanket reinvestment prefunding deduction. The reserve scales with perpetual revenue, so its annual growth is separately deducted from distributable FCFF. Baseline perpetual growth 3% and discount rate 16% require positive continuing FCFF, funded reserve, all debt settled and no earlier breach. Enterprise value is next distributable FCFF divided by (16%−3%), plus only cash above the required reserve for equity. No interim dividend or cash-distribution double count occurs. The implied terminal P/E is an output, not a borrowed software multiple.\\n\\n### Reverse expectations, hurdle prices and sensitivity\\n\\n| Variable | Target | Threshold | Meaning |\\n|---|---|---|---|\\n| margin | Current price, 0% return | 16.81% | valuation crossing |\\n| margin | 12% hurdle | 23.44% | valuation crossing |\\n| margin | 15% hurdle | 25.63% | valuation crossing |\\n| margin | 18% hurdle | 28.06% | valuation crossing |\\n| margin | 5× | NS | No jointly cash-feasible/value-meeting path in bounded scan; no extrapolated root |\\n| margin | 10× | NS | No jointly cash-feasible/value-meeting path in bounded scan; no extrapolated root |\\n| growth | Current price, 0% return | NS | No jointly cash-feasible/value-meeting path in bounded scan; no extrapolated root |\\n| growth | 12% hurdle | NS | No jointly cash-feasible/value-meeting path in bounded scan; no extrapolated root |\\n| growth | 15% hurdle | NS | No jointly cash-feasible/value-meeting path in bounded scan; no extrapolated root |\\n| growth | 18% hurdle | NS | No jointly cash-feasible/value-meeting path in bounded scan; no extrapolated root |\\n| growth | 5× | NS | No jointly cash-feasible/value-meeting path in bounded scan; no extrapolated root |\\n| growth | 10× | NS | No jointly cash-feasible/value-meeting path in bounded scan; no extrapolated root |\\n\\nThese bounded scans solve jointly for financing survival and terminal value, rather than filling a missing failed-path IRR with a number. Margin scans cover 8%–36% at 15% revenue growth; growth scans cover 0%–60% at 15% margin, all conditional on the improved pre-entry bridge. A funding discontinuity is explicitly distinguished from a smooth valuation crossing. Every coarse scan, failed lower endpoint and 20-step refinement is retained; no missing root is extrapolated outside its stated range.\\n\\n| Conditional path | 12% hurdle | 15% hurdle | 18% hurdle |\\n|---|---|---|---|\\n| improved collection bridge / base / bounded optional | NS | NS | NS |\\n| improved collection bridge / bull / bounded optional | 163.82 | 143.54 | 126.19 |\\n\\nThese are conditional path-equivalent prices, not actionable buy zones: a surviving bull path does not turn an unsupported base case into R. The improved-bridge bull returns about 14.02% at the reference price, below the 15% hurdle despite 25% revenue growth, 18% margins and 180-day DSO. At fixed 15% growth, the modeled 15% shareholder hurdle requires approximately 25.63% margin, conditional on the bridge and funding discipline, well above observed normalized operating margin.\\n\\n| Sensitivity | Survives | First breach | Rescue ₹cr | Terminal ₹ | IRR |\\n|---|---|---|---|---|---|\\n| bank gross cap 0 | False | 2031-10-19 | 10.00 | NS | NS |\\n| post DSO 180 | True | None | 0.00 | 159.54 | 1.27% |\\n| post DSO 300 | False | 2028-12-22 | 10.00 | NS | NS |\\n| margin .18 | True | None | 0.00 | 171.32 | 2.72% |\\n| margin .22 | True | None | 0.00 | 239.49 | 9.84% |\\n| line rollover .8 | False | Continuation reserve | 10.00 | NS | NS |\\n| cycle count 4 | True | None | 0.00 | 288.71 | 14.02% |\\n| cycle count 16 | True | None | 0.00 | 288.70 | 14.02% |\\n| terminal k .13 g .03 | True | None | 0.00 | 368.95 | 19.75% |\\n| terminal k .19 g .03 | True | None | 0.00 | 238.54 | 9.75% |\\n\\nFull one-variable sensitivities cover DSO, within-period collection timing, capex, IPO fees, gross bank availability, rescue discounts, cash floor, rollover and cycle granularity. A 5×4 growth/margin matrix and 3×3 perpetual discount/growth matrix are included. Downside cases are not assigned peer-multiple rescue values. Current-price expectations remain NS until operating/funding evidence supports a base path.\\n\\nThe archive retains **191 retained trial aliases, 187 unique complete paths, 67 failed unique paths**, losslessly keyed by path ID. Every path includes all cash events, pre-entry and monthly balances, annual financials, rescue terms and next-year continuation events. Repeated trials share an identical path object but each requested trial has an alias. Failed paths are not dropped to make the output look cleaner.\\n\\n\"","\"Bear Case & Permanent-Loss Path\"","\"\\nThe strongest adverse case is not merely a lower terminal multiple. A concentrated institution/channel delays or disputes acceptance; receivables age beyond finance eligibility; suppliers shorten terms; cash-credit renewal tightens; interest, taxes and acquired-owner claims consume fresh funds; a deeply discounted issue exhausts authorized/gross capacity before collections arrive. A 10% opening receivable write-off is ₹7.1278 crore, material relative to reported equity, without any claim that this loss has occurred. Loss of the largest FY26 customer could affect approximately 21% of sales before replacement and cost adjustment.\\n\\nThe cash-linked bear case jointly tests slower growth, a 10% margin, 360-day collection, 85-day inventory, 50-day supplier terms, 80% line renewal and the receivable haircut. Failed financing paths have no ordinary terminal share price, not a fabricated precision liquidation value. Actual equity recovery would require receivable aging/realizations, secured-creditor priorities, taxes and asset liquidation evidence that is unavailable. Material impairment and recapitalization risk justify D 3, while absence of actual default evidence keeps G3 conditional.\\n\\nThe best counterargument is that IPO liquidity, prior-receivable collection and broader customers allow profitable lab delivery to convert into cash, while subscriptions improve margins. The model gives that argument a cash-feasible chance, but only under explicit collection/margin assumptions. **Thesis-break variable: funded cash conversion**, not announced school reach. Repeated negative CFO after the financing cycle, uncollectible/disputed major receivables or an uncovered callable-debt event would override a growing order pipeline.\\n\\n\"","\"5× / 10× Feasibility\"","\"\\nFive-year 5× and 10× prices require annualized shareholder returns of approximately 37.97% and 58.49%, respectively, before taxes and trading costs. They are not equivalent to company revenue CAGR. The retained reverse tests calculate target prices ₹749 and ₹1,498 from ₹149.80 and require survival of every preceding cash event, all dilution/interest/principal, a funded growing cash reserve and cash-flow-supported terminal value. Profit growth, per-share dilution and the implied terminal multiple are separately visible in `reverse_tests.json`.\\n\\nA margin root above the observed sustainable operating evidence is an assumption threshold, not proof of a multibagger. Where no jointly feasible root exists within the bounded growth or margin range, the answer is “not demonstrated,” not an extrapolated optimistic price. Acquisition revenue, repeat-customer claims, more franchise logos or a SaaS multiple cannot substitute for cash earned per share. Neither a 5× nor 10× outcome is a supported base expectation here.\\n\\n\"","\"Monitoring Plan\"","\"\\n1. **Cash-flow correction:** obtain a signed original-to-restated FY24/FY25 CFO/cash bridge, specifically borrowing in CFO, CC/OD and loan-conversion cash. Unexplained financing classification keeps G2 on Hold.\\n2. **Current liquidity:** post-IPO bank statements/cash balance, loan confirmations and uses of ₹31.08768 crore gross proceeds, with fees, ₹2.2 crore debt allocation, acquisition consideration and tax/statutory payments. No double-counting of April OCD cash.\\n3. **Receivable realization:** collect the March ₹71.2776 crore book, acquired versus organic amounts, aging, disputes and amounts eligible under lender terms. Failure to approach a funded 220–240-day path is adverse, not merely slower accounting growth.\\n4. **External revenue bridge:** parent/subsidiary elimination schedule, new/repeat customer cohorts, project acceptance and lab/subscription split. Resolve the FY24/25 majority-RPT channel before scoring organic REV.\\n5. **Bank renewals:** limits, drawing power, collateral, covenant status, rates and callable balances. Stress any loss of the modeled ₹3 crore optional capacity; do not wait for a formal default to update D.\\n6. **Subscription economics:** contracted seats, paid renewal/cohort revenue, support/LMS cost and cash collection. Use true renewal evidence, not number of schools ever reached.\\n7. **Capital productivity:** incremental lab/centre/software investment, acquired capital and organic NOPAT, including failed or delayed centres. CAP stays NS until a comparable return denominator is available.\\n8. **Governance execution:** resolve CARO lender, subsidiary-timing, statutory/MSME and confirmation inconsistencies; track filing timeliness and any material RPT/related-party payment change.\\n9. **Tradability:** obtain official daily traded-value history, zero-trade days, spread/depth, free float and current restrictions. Recompute ₹5 lakh capacity at 2%, 5%, 10%; an indicative close is never an exit guarantee.\\n10. **Falsification:** sustained positive cash after taxes/support costs and normal reinvestment, with no hidden borrowing in CFO, supports re-underwriting. Continued multiyear negative conversion or equity needed merely to pay earlier claims defeats the compounder claim.\\n\\n\"","\"Final Classification & Conditional Action\"","\"\\n**Hold — unresolved financial reliability and funding evidence.** BQS, GQS and IAS remain NS, with explicit bounds and confidence. Do not place this company in a numeric Best Businesses, Best Growth or Best Investments ranking until the missing evidence is resolved. This is not “Avoid — governance” because severe diversion/minority abuse is not established, nor “Avoid — funding” merely because an assumed cash schedule breaches. G2's unresolved reliability gate precedes the classification matrix.\\n\\nNo compounder designation is supportable: BQS≥8/GQS≥7 and sustained reinvestment/cash conditions are not established. No portfolio allocation or executable entry instruction follows. A lower observed price can improve conditional modeled returns, but cannot fix an unverified cash bridge or provide liquidity. The appropriate next action is primary reconciliation and post-IPO evidence, then rebuild the same canonical factors and cash model without changing the scoring goalposts.\\n\\nResearch update: initial v3.0 review as of the stated cutoff. Earlier FY20–23 audited vintages, original versus restated FY24–26 differences and secondary-price limitations have been added explicitly; no later market event is used to improve hindsight. Scores are research-policy heuristics, not statistically validated predictors.\\n\\n\"","\"Sources, Assumptions & Open Questions\"","\"\\n| ID | Record / date | Reviewed use |\\n|---|---|---|\\n| AR22 | [Annual Report – FY 2021-22 (PDF)](https://www.robokidz.co.in/media/documents/04-annual-report-fy-2021-22.pdf) · FY ended 2022-03-31 | Entire original audit/opinion, CARO/IFC where applicable, financial statements and relevant notes. Original report issuer identity and units checked. Original versus restated vintages preserved. |\\n| AR23 | [Annual Report – FY 2022-23 (PDF)](https://www.robokidz.co.in/media/documents/03-annual-report-fy-2022-23.pdf) · FY ended 2023-03-31 | Entire original audit/opinion, CARO/IFC where applicable, financial statements and relevant notes. Original report issuer identity and units checked. Original versus restated vintages preserved. |\\n| AR24 | [Annual Report – FY 2023-24 (PDF)](https://www.robokidz.co.in/media/documents/02-annual-report-fy-2023-24.pdf) · FY ended 2024-03-31 | Entire original audit/opinion, CARO/IFC where applicable, financial statements and relevant notes. Original report issuer identity and units checked. Original versus restated vintages preserved. |\\n| ADD | [Addendum to DRHP (PDF)](https://www.robokidz.co.in/media/documents/04-addendum-to-drhp.pdf) · 2026 pre-RHP | Disqualification, revised risk/RPT and business disclosures. |\\n| RHP | [RHP (PDF)](https://www.robokidz.co.in/media/documents/03-rhp.pdf) · 2026-09-11 | RHP front matter, risks, capital structure, objects, business, history, governance, entire restated examination report and RFS1–54, MDA, litigation, approvals. |\\n| AR21 | [Annual Report – FY 2020-21 (PDF)](https://www.robokidz.co.in/media/documents/05-annual-report-fy-2020-21.pdf) · FY ended 2021-03-31 | Entire original audit/opinion, CARO/IFC where applicable, financial statements and relevant notes. Original report issuer identity and units checked. Original versus restated vintages preserved. |\\n| WRONG-AUDIT | [Audit Report – FY 2024-25 (PDF)](https://www.robokidz.co.in/media/documents/06-audit-report-fy-2024-25.pdf) · FY2025 | Identity check only: linked file belongs to Bharat Gyan Vigyan Foundation, not issuer. Excluded from issuer opinion conclusions. |\\n| AR25 | [Annual Report – FY 2024-25 (PDF)](https://www.robokidz.co.in/media/documents/01-annual-report-fy-2024-25.pdf) · FY ended 2025-03-31 | Entire original audit/opinion, CARO/IFC where applicable, financial statements and relevant notes. Original report issuer identity and units checked. Original versus restated vintages preserved. |\\n| SEC | [NSE interoperability security master](https://nsearchives.nseindia.com/content/cm/interop/NSE_CM_security_19102026.csv.gz) · 2026-10-19 | Exact ISIN, issued shares and lot; not represented as a separate NSE listing or executable quote. |\\n| MKT | [Finology observed quote](https://ticker.finology.in/Company/SCRIP-325713) · 2026-10-19 | Observed secondary price ₹149.80; displayed legacy P/E and debt are not adopted. |\\n| LIST | [BSE listing notice 20260925-42, mirrored by NoticeBlue](https://noticeblue.com/circulars/a3fbe800-ded3-4528-bf13-09db1a43f494) · 2026-09-25 | 10,859,453 shares, 1,200-share lot, ₹106 issue price and September 28 listing. Official endpoint unavailable; mirror labeled. |\\n| PEER-MTS | [NIIT Learning Systems FY26 results](https://www.niit.com/en/learning-outsourcing/news-details/niit-mts-q4-fy26-financial-results/) · 2026-05-12 | Issuer FY26 results: ₹1,952 crore revenue, ₹395.7 crore EBITDA, ₹247.7 crore PAT; 21 new annuity clients and USD459 million visibility. Corporate services comparator, not a lab-project multiple. |\\n| PEER-NIIT | [NIIT Limited FY26 results](https://www.niit.ai/india/press-release/niit-limited-q4-fy2025-26-consolidated-results) · 2026-05-14 | Issuer FY26 results: ₹390.2 crore revenue, EBITDA loss ₹4 crore and PAT ₹5.3 crore. Skills demand does not guarantee operating profitability. |\\n| PEER-CLE | [CL Educate FY26 annual report](https://www.cleducate.com/pdf/annual-reports/2026/CL-Educate-Annual-Report-2025-26.pdf) · FY2026 issued2026 | FY26 business model, franchise network and acquisition bridge: ₹548.1 crore revenue and about ₹26 crore net loss. First full year of DEXIT changes perimeter. |\\n| PEER-STEM | [STEMROBO official business description](https://www.stemrobo.com/about-us/) · Undated, retrieved2026-10-23 | Direct curriculum/kits/AI robotics lab competitor; undated web description used only to identify mechanism, not assert historical scale or financial performance. |\\n\\nThe full source register carries primary-file hashes, review scope and cutoff eligibility. Evidence type is explicit: verified document fact, issuer/management assertion, secondary quote/mirror, or analyst assumption. Undated competitor web content is not cutoff-dated financial evidence. Official BSE daily-data attempts returned access failures; failures do not prove zero trading. The official security master establishes only fields actually read. No raw PDF, OCR, private download URL, helper code or private Library ID is included in the deliverables.\\n\\nAll model inputs are bundled with standard-library code in both compact and full recovery archives. Compact contains authored minimal inputs and code, so it can regenerate every complete path and failed root without access to original PDFs, web, private directories or precomputed outputs. Full adds generated tables and lossless path history. Clean rebuilding removes generated outputs and old attestations before running under declared read/write restrictions and a network/process prohibition. Rebuild checks validate arithmetic and internal consistency; they do not turn unresolved economic evidence into verified facts.\\n\\nKey open questions are signed historical cash reconciliation; current available cash/debt and IPO utilization; original FY26 full audit annexures; organic/acquired/customer-elimination bridges; capital cohort paybacks; recurring subscription retention; and primary executable market evidence. No approval to trade, new financing commitment or forecast certainty is inferred.\\n\\n### Required v3 final checks\\n\\n| # | Required check | Status | Disposition |\\n|---|---|---|---|\\n| 1 | Identity and scope | PASS with qualification | ISIN/share count verified; standalone versus last-day consolidated scope explicit; price secondary. |\\n| 2 | Primary records | PASS | Original FY21–25 audits and full RHP examination/notes reviewed; claims source-linked. |\\n| 3 | Audit/RPT/funding/dilution | PASS with unresolved gate | Adverse findings proportionate; G2 Hold, G1/G3 conditional, no invented default. |\\n| 4 | Comparable periods and units | PASS with limitation | Original rupees/INR00 converted to crore, vintages distinct; no invented TTM or quarterly CFO. |\\n| 5 | Growth decomposition | UNRESOLVED and NS | Organic/acquired/elimination bridge unavailable; nominal CAGR diagnostics not REV score. |\\n| 6 | Cash conversion | PASS | Matched ratio of sums; capex outside CFO; original borrowing misclassification isolated. |\\n| 7 | Incremental capital | UNRESOLVED and NS | 3/5-year numerator/denominator proxies visible; lagged/cohort return unsupported, CAP NS. |\\n| 8 | Normalization and claims | PASS with limitation | Other income, operating D&A, taxes, lease expense, acquisition liability and all issue shares reconciled. |\\n| 9 | Cash-linked scenarios | PASS | Dated pre-entry/intraperiod cash, integer rescue caps, first failures retained, terminal debt and continuation cash tested. |\\n| 10 | Canonical factors and weights | PASS | Single factor register; all three weights sum exactly one. |\\n| 11 | Missing evidence | PASS | NS stays null; coverage, bounds and confidence supplied. |\\n| 12 | Raw/final overrides | PASS | Only persistent CASH cap on GQS; no governance/funding cap invented. |\\n| 13 | Classification | PASS | Gate Hold precedes matrix; no compounder or investable ranking. |\\n| 14 | Liquidity | UNRESOLVED and NS | ₹5 lakh reference, 1200 lot, 2/5/10% formula; incomplete primary tape, no executable-price claim. |\\n| 15 | Bear and falsification | PASS | Concentration/collections/rollover/recapitalization path and measurable breakers explicit. |\\n| 16 | Ranking consistency | PASS | v3.0 common basis; incomplete company excluded from numeric ranking, not imputed or ranked. |\\n\\nConcluding assessment: recorded revenue has expanded substantially, but the evidence does not yet establish that expansion can repeatedly protect economics, earn attractive incremental returns, become cash and increase intrinsic value per share without fragile funding. The conditional price model quantifies what must change; it does not waive the evidence gap.\\n\"","\"heading_start\"","\"body_start\""